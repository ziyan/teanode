<?xml version="1.0" encoding="utf-8"?>
<!-- Plain http is for a development server on the phone's own loopback (an adb reverse or a local tunnel): the app
     refuses every other http address before it asks Android, so this only has to let that one through. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
