    <string name="settings_server_field_antispam_rulesEnabled">公开的模式规则，用 \"config rules import\" 加载</string>
    <string name="settings_server_field_antispam_signalsEnabled">服务器已有的信号：认证结果、反向 DNS、HELO</string>
    <string name="settings_server_field_antivirus_enabled">已启用</string>
    <string name="settings_server_field_antivirus_host">主机</string>
    <string name="settings_server_field_antivirus_port">端口</string>
    <string name="settings_server_field_certificates_acmeDirectoryUrl">颁发机构</string>
    <string name="settings_server_field_certificates_acmeDirectoryUrl_hint">ACME 目录 URL。留空即 Let’s Encrypt。测试期间请指向它们的 staging 目录：那里签发的证书不被信任，但速率限制宽松得多。</string>
    <string name="settings_server_field_certificates_acmeEmail">联系邮箱</string>
    <string name="settings_server_field_certificates_acmeEmail_hint">出问题时，或证书即将过期却未能续期时，证书颁发机构会写信到这里。不会公开在任何地方。</string>
    <string name="settings_server_field_certificates_acmeEnabled">自动申请证书</string>
    <string name="settings_server_field_certificates_certificateFile">证书文件</string>
    <string name="settings_server_field_certificates_certificateFile_hint">手工提供的 PEM 格式证书，在不自动申请证书时使用。相对路径按配置目录解析。</string>
    <string name="settings_server_field_certificates_hosts">本服务器证书覆盖的名字</string>
    <string name="settings_server_field_certificates_hosts_hint">逗号分隔。服务器自身证书覆盖的名字，控制台的地址，以及本服务器的邮件服务器名。像 *.example.com 这样的通配符需要 dns-01 验证方式。</string>
    <string name="settings_server_field_certificates_perDomain">为每个域名签发使用其自身名称的证书</string>
    <string name="settings_server_field_certificates_privateKeyFile">私钥文件</string>
    <string name="settings_server_field_certificates_privateKeyFile_hint">与该证书配对的 PEM 格式私钥。请只让运行本服务器的用户可读。</string>
    <string name="settings_server_field_geoip_databaseFile">数据库文件</string>
    <string name="settings_server_field_geoip_databaseFile_hint">GeoLite2-Country.mmdb 或 GeoLite2-City.mmdb 的路径。相对路径按数据目录解析。</string>
    <string name="settings_server_field_geoip_enabled">查询发件方的连接来源地</string>
    <string name="settings_server_field_identity_externalAddresses">其他可达地址</string>
    <string name="settings_server_field_identity_externalAddresses_hint">当邮件不是通过本机地址到达时所经过的地址：前置转发、隧道或负载均衡。指向这些地址的邮件服务器名称是正确的，无需修改记录。以逗号分隔；也可填写域名，检查时会解析。</string>
    <string name="settings_server_field_identity_mailServers">邮件服务器名称</string>
    <string name="settings_server_field_identity_mailServers_hint">逗号分隔。除非某个域在自己的“设置”标签页里另行指定，否则所有域的 MX 记录都指向这些主机。改动它会改变每个域需要发布的记录。</string>
    <string name="settings_server_field_identity_name">姓名</string>
    <string name="settings_server_field_identity_name_hint">本服务器在 SMTP 欢迎语中给出的名字，也是它自己证书的来源。如果这个名字解析不到本机，别的服务器会对你发出的邮件起疑。</string>
    <string name="settings_server_field_listen_debug">性能分析</string>
    <string name="settings_server_field_listen_debug_hint">Go 性能分析端点的地址，留空即关闭。它自身没有任何鉴权，所以只绑定到 127.0.0.1。</string>
    <string name="settings_server_field_listen_http">HTTP</string>
    <string name="settings_server_field_listen_http_hint">通常是 :80。它负责 ACME 的 http-01 验证并把其余请求重定向，所以关掉它会让 http-01 方式的证书无法续期。</string>
    <string name="settings_server_field_listen_https">HTTPS</string>
    <string name="settings_server_field_listen_https_hint">仪表板的服务地址，通常是 :443。这是访问仪表板所用的地址。</string>
    <string name="settings_server_field_listen_imap">IMAP（STARTTLS）</string>
    <string name="settings_server_field_listen_imap_hint">同样的服务在端口 143 上，客户端必须先请求加密才能登录。留空则关闭。</string>
    <string name="settings_server_field_listen_imaps">IMAP（TLS）</string>
    <string name="settings_server_field_listen_imaps_hint">邮件客户端读取邮箱的入口，从第一个字节起加密：端口 993。留空则关闭。</string>
    <string name="settings_server_field_listen_smtpIncoming">接收邮件</string>
    <string name="settings_server_field_listen_smtpIncoming_hint">其他服务器投递来的邮件从哪里进来，通常是 :25。改了它却没有同时改转发到它的东西，邮件就完全收不到了。</string>
    <string name="settings_server_field_listen_smtpOutgoing">提交</string>
    <string name="settings_server_field_listen_smtpOutgoing_hint">你自己的设备把待发邮件交给本服务器的地方，通常是 :587。按旧端口配置的邮件客户端将无法再发信。</string>
    <string name="settings_server_field_passkey_displayName">显示为</string>
    <string name="settings_server_field_passkey_displayName_hint">验证器向正在决定是否允许的人展示的名称。用文字写出你的服务器名，而不是主机名。</string>
    <string name="settings_server_field_passkey_enabled">允许使用通行密钥登录</string>
    <string name="settings_server_field_passkey_maximumPerUser">每个账户的通行密钥数量</string>
    <string name="settings_server_field_passkey_maximumPerUser_hint">一位管理员最多可注册多少个。填 0 表示不限。多于一个是正常的：手机和笔记本就是两个。</string>
    <string name="settings_server_field_passkey_origins">来源</string>
    <string name="settings_server_field_passkey_origins_hint">逗号分隔的允许发起验证的来源，写作 https://mail.example.com。留空则从上面的名字推导；除非控制台有多个访问地址，否则留空即可。</string>
    <string name="settings_server_field_passkey_relyingPartyId">绑定到</string>
    <string name="settings_server_field_passkey_relyingPartyId_hint">通行密钥所属的域名，不带协议和端口：mail.example.com。留空则从访问控制台的地址推导。按旧值注册的通行密钥都会失效。</string>
    <string name="settings_server_field_places_mapStyleUrl">地图样式地址</string>
    <string name="settings_server_field_places_mapStyleUrl_hint">控制台绘制地图所用的 MapLibre 样式。本服务器会从该地址的主机获取样式和图块，再交给浏览器。</string>
    <string name="settings_server_field_places_providerUrl">服务商地址</string>
    <string name="settings_server_field_places_providerUrl_hint">https 地址；本机或您自己网络中的服务器（例如您自己运行的）可以用 http。</string>
    <string name="settings_server_field_proxy_socks5">SOCKS5 代理</string>
    <string name="settings_server_field_proxy_socks5_hint">格式为 host:port。留空表示发出的邮件直接从本机出去。</string>
    <string name="settings_server_field_relay_enabled">通过中继发送</string>
    <string name="settings_server_field_relay_host">主机</string>
    <string name="settings_server_field_relay_password">密码</string>
    <string name="settings_server_field_relay_port">端口</string>
    <string name="settings_server_field_relay_username">用户名</string>
    <string name="settings_server_field_resolver_checkInterval">每隔多久检查一次</string>
    <string name="settings_server_field_resolver_checkInterval_hint">写作 6h 或 30m。它决定域名页上的 DNS 一列多快会注意到你已经改好了记录；“重新检查”按钮不必等它。</string>
    <string name="settings_server_field_resolver_externalAddressServices">公网地址查询服务</string>
    <string name="settings_server_field_resolver_externalAddressServices_hint">逗号分隔的 URL，按顺序询问本机的公网地址，用来填出域名应当发布的 A 记录。只有前一个没有回应时才会问下一个。</string>
    <string name="settings_server_field_resolver_nameserver">解析器</string>
    <string name="settings_server_field_resolver_nameserver_hint">写作 host:port，例如 1.1.1.1:53。留空则使用本机的解析设置。缓存过于激进的解析器，会让你刚刚发布的记录在缓存期内一直显示为缺失。</string>
    <string name="settings_server_field_route53_accessKeyId">访问密钥 ID</string>
    <string name="settings_server_field_route53_enabled">已启用</string>
    <string name="settings_server_field_route53_region">区域</string>
    <string name="settings_server_field_route53_secretAccessKey">私有访问密钥</string>
    <string name="settings_server_field_route53_zoneId">托管区域 ID</string>
    <string name="settings_server_field_s3_accessKeyId">访问密钥 ID</string>
    <string name="settings_server_field_s3_bucket">存储桶</string>
    <string name="settings_server_field_s3_enabled">已启用</string>
    <string name="settings_server_field_s3_endpoint">端点</string>
    <string name="settings_server_field_s3_endpoint_hint">非 AWS 的 S3 兼容服务。使用 AWS 时留空。</string>
    <string name="settings_server_field_s3_pathStyle">以 端点/存储桶 的形式寻址</string>
    <string name="settings_server_field_s3_region">区域</string>
    <string name="settings_server_field_s3_secretAccessKey">私有访问密钥</string>
    <string name="settings_server_field_session_lifetime">会话有效期</string>
    <string name="settings_server_field_session_lifetime_hint">写作 720h 或 30d。缩短它不会结束已经签发的会话：它们在创建时就带上了当时的有效期。要结束那些，请到你账户的“会话”页面。</string>
    <string name="settings_server_field_smtp_authRateBurst">允许的突发次数</string>
    <string name="settings_server_field_smtp_authRateBurst_hint">在开始限速之前允许失败多少次。自己打错密码的人不该被它拦住。</string>
    <string name="settings_server_field_smtp_authRateLimit">每分钟登录尝试次数</string>
    <string name="settings_server_field_smtp_authRateLimit_hint">同一个地址登录失败到多快就开始被限速。这是弱密码和逐个试密码的人之间唯一的屏障。</string>
    <string name="settings_server_field_smtp_greylistDelay">灰名单延迟</string>
    <string name="settings_server_field_smtp_greylistDelay_hint">第一次见到的发件方需要等待多久后重试，写作 5m 或 0s。正规邮件服务器会重试；不会重试的多半也不值得收。填 0s 即关闭。</string>
    <string name="settings_server_field_smtp_maxMessageSize">单封邮件上限</string>
    <string name="settings_server_field_smtp_maxMessageSize_hint">要带单位，和配置文件里一样：50MB、25MiB、10485760。超过此值的邮件在接收过程中就会被拒绝，因此发件方会收到明确的告知，而不是不明所以。</string>
    <string name="settings_server_field_smtp_maxRecipientsIncoming">每封来信的收件人上限</string>
    <string name="settings_server_field_smtp_maxRecipientsIncoming_hint">一封进来的邮件最多可以写多少个地址，超出的会被拒绝。一封信同时寄给你这里好几个地址，通常是有人在猜测地址。</string>
    <string name="settings_server_field_smtp_maxRecipientsOutgoing">每封发信的收件人上限</string>
    <string name="settings_server_field_smtp_maxRecipientsOutgoing_hint">你自己的设备提交的邮件同理。它决定了一次误操作最多能扩散到多远。</string>
    <string name="settings_server_field_smtp_trustedSenders">受信任的发件来源</string>
    <string name="settings_server_field_smtp_trustedSenders_hint">逗号分隔的地址或网段，例如 10.0.0.0/8 或 192.168.1.5，可以跳过陌生来源要过的检查。列在这里的可以冒充任何人发信，所以只填你自己的机器。</string>
    <string name="settings_server_field_storage_directory">邮件目录</string>
    <string name="settings_server_field_storage_directory_hint">位于数据目录之下。改动它不会搬走已经存在的内容，因此旧目录里的邮件将无法再从控制台读取。</string>
    <string name="settings_server_field_storage_spoolRetention">重试保留时长</string>
    <string name="settings_server_field_storage_spoolRetention_hint">写作 30d 或 72h。一封一直投递失败的邮件在队列中停留多久后放弃并退信。</string>
</resources>
