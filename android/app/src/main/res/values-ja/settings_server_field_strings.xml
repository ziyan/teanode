    <string name="settings_server_field_antispam_bayesEnabled">このサーバーのメールで学習した分類器</string>
    <string name="settings_server_field_antispam_bayesMinimumMessages">分類器が発言するまでに学習するメール数</string>
    <string name="settings_server_field_antispam_dnsEnabled">公開ブロックリスト（DNS 経由）</string>
