    <string name="settings_server_field_antispam_host">ホスト</string>
    <string name="settings_server_field_antispam_port">ポート</string>
    <string name="settings_server_field_antispam_rulesEnabled">公開パターンルール（\"config rules import\" で読み込み）</string>
    <string name="settings_server_field_antispam_signalsEnabled">サーバーが既に持つシグナル：認証結果、逆引き DNS、HELO</string>
    <string name="settings_server_field_antivirus_enabled">有効にしました</string>
    <string name="settings_server_field_antivirus_host">ホスト</string>
    <string name="settings_server_field_antivirus_port">ポート</string>
    <string name="settings_server_field_certificates_acmeDirectoryUrl">認証局</string>
    <string name="settings_server_field_certificates_acmeDirectoryUrl_hint">ACME のディレクトリ URL。空なら Let’s Encrypt です。試している間は staging のディレクトリに向けてください。証明書は信頼されませんが、回数の制限がずっと緩やかです。</string>
    <string name="settings_server_field_certificates_acmeEmail">連絡先アドレス</string>
    <string name="settings_server_field_certificates_acmeEmail_hint">不具合があったとき、あるいは更新されないまま証明書が切れそうなときに認証局が書き送る先です。どこにも公開されません。</string>
    <string name="settings_server_field_certificates_acmeEnabled">証明書を自動で取得する</string>
    <string name="settings_server_field_certificates_certificateFile">証明書ファイル</string>
    <string name="settings_server_field_certificates_certificateFile_hint">自分で用意した PEM 形式の証明書で、自動取得を使わないときに用います。相対パスは設定ディレクトリから解決されます。</string>
    <string name="settings_server_field_certificates_hosts">このサーバーの証明書が覆う名前</string>
    <string name="settings_server_field_certificates_hosts_hint">カンマ区切り。サーバー自身の証明書が覆う名前で、ダッシュボードのアドレスとこのサーバーのメールサーバー名です。*.example.com のようなワイルドカードには dns-01 が要ります。</string>
    <string name="settings_server_field_certificates_perDomain">ドメインごとに、そのドメイン名の証明書を取得する</string>
    <string name="settings_server_field_certificates_privateKeyFile">秘密鍵ファイル</string>
    <string name="settings_server_field_certificates_privateKeyFile_hint">その証明書に対応する PEM 形式の鍵です。このサーバーを動かすユーザーだけが読めるようにしてください。</string>
    <string name="settings_server_field_geoip_databaseFile">データベースファイル</string>
    <string name="settings_server_field_geoip_databaseFile_hint">GeoLite2-Country.mmdb または GeoLite2-City.mmdb のパス。相対パスはデータディレクトリから解決されます。</string>
    <string name="settings_server_field_geoip_enabled">送信元の接続地を調べる</string>
    <string name="settings_server_field_identity_externalAddresses">ほかに到達するアドレス</string>
    <string name="settings_server_field_identity_externalAddresses_hint">このサーバー自身のアドレスではなく、メールが実際に届くアドレス。前段のリレー、トンネル、ロードバランサーなど。これらを指すメールサーバー名は正しく、変更の必要はありません。カンマ区切り。名前も指定でき、判定時に解決されます。</string>
    <string name="settings_server_field_identity_mailServers">メールサーバー名</string>
    <string name="settings_server_field_identity_mailServers_hint">カンマ区切り。ドメインが自分の「設定」タブで指定しない限り、すべてのドメインの MX レコードが指すホストです。変えると各ドメインが公開すべきレコードも変わります。</string>
    <string name="settings_server_field_identity_name">名前</string>
    <string name="settings_server_field_identity_name_hint">SMTP の挨拶で名乗る名前で、自分の証明書もここから導かれます。この機械に解決しない名前は、送ったメールを他のサーバーに疑わせます。</string>
    <string name="settings_server_field_listen_debug">プロファイリング</string>
    <string name="settings_server_field_listen_debug_hint">Go のプロファイリング用アドレスで、空なら無効です。独自の認証を持たないので、127.0.0.1 だけに結び付けてください。</string>
    <string name="settings_server_field_listen_http">HTTP</string>
    <string name="settings_server_field_listen_http_hint">通常は :80。ACME の http-01 チャレンジに応え、他はすべてリダイレクトします。止めると http-01 方式の証明書が更新できなくなります。</string>
    <string name="settings_server_field_listen_https">HTTPS</string>
    <string name="settings_server_field_listen_https_hint">このダッシュボードを配信する場所。通常は :443 です。ダッシュボードにアクセスするアドレスです。</string>
    <string name="settings_server_field_listen_imap">IMAP（STARTTLS）</string>
    <string name="settings_server_field_listen_imap_hint">同じものをポート 143 で。ソフトはサインイン前に暗号化を要求する必要があります。空にすると無効です。</string>
    <string name="settings_server_field_listen_imaps">IMAP（TLS）</string>
    <string name="settings_server_field_listen_imaps_hint">メールソフトがメールボックスを読む口。最初から暗号化されます。ポート 993。空にすると無効です。</string>
    <string name="settings_server_field_listen_smtpIncoming">受信</string>
    <string name="settings_server_field_listen_smtpIncoming_hint">他のサーバーからのメールが届く場所で、通常は :25。転送元を直さずにここだけ変えると、メールがまったく届かなくなります。</string>
    <string name="settings_server_field_listen_smtpOutgoing">投稿</string>
    <string name="settings_server_field_listen_smtpOutgoing_hint">自分の端末が送信するメールをこのサーバーに渡す場所で、通常は :587。古いポートで設定されたメールソフトは送信できなくなります。</string>
    <string name="settings_server_field_passkey_displayName">表示名</string>
    <string name="settings_server_field_passkey_displayName_hint">許可するかを判断する人に認証器が見せる名前です。ホスト名ではなく、言葉としてのサーバー名を。</string>
    <string name="settings_server_field_passkey_enabled">パスキーでのサインインを許可する</string>
    <string name="settings_server_field_passkey_maximumPerUser">アカウントあたりのパスキー数</string>
    <string name="settings_server_field_passkey_maximumPerUser_hint">一人が登録できる数です。0 は無制限。複数が普通です。携帯とノートで二つになります。</string>
    <string name="settings_server_field_passkey_origins">オリジン</string>
    <string name="settings_server_field_passkey_origins_hint">手続きの発信元として許すオリジンをカンマ区切りで、https://mail.example.com のように。空なら上の名前から導かれ、ダッシュボードのアドレスが一つならそれで十分です。</string>
    <string name="settings_server_field_passkey_relyingPartyId">結び付ける名前</string>
    <string name="settings_server_field_passkey_relyingPartyId_hint">パスキーが属するドメイン。スキームやポートは付けません：mail.example.com。空ならダッシュボードのアドレスから導かれます。古い値で登録したパスキーは動かなくなります。</string>
    <string name="settings_server_field_places_mapStyleUrl">地図スタイルのアドレス</string>
    <string name="settings_server_field_places_mapStyleUrl_hint">ダッシュボードが地図を描くのに使う MapLibre スタイル。このサーバーがこのアドレスのホストからスタイルとタイルを取得し、ブラウザーに渡します。</string>
    <string name="settings_server_field_places_providerUrl">提供元のアドレス</string>
    <string name="settings_server_field_places_providerUrl_hint">https のアドレス。この機械や自分のネットワーク上のサーバー（自分で運用しているものなど）なら http でも構いません。</string>
    <string name="settings_server_field_proxy_socks5">SOCKS5 プロキシ</string>
    <string name="settings_server_field_proxy_socks5_hint">host:port 形式。空欄なら送信メールはこのマシンから直接出ます。</string>
    <string name="settings_server_field_relay_enabled">リレー経由で送信する</string>
    <string name="settings_server_field_relay_host">ホスト</string>
    <string name="settings_server_field_relay_password">パスワード</string>
    <string name="settings_server_field_relay_port">ポート</string>
    <string name="settings_server_field_relay_username">ユーザー名</string>
    <string name="settings_server_field_resolver_checkInterval">各ドメインを確認する間隔</string>
    <string name="settings_server_field_resolver_checkInterval_hint">6h や 30m のように書きます。ドメインの DNS 列がレコードの修正に気づく速さで、「もう一度確認」ボタンはこれを待ちません。</string>
    <string name="settings_server_field_resolver_externalAddressServices">アドレス照会先</string>
    <string name="settings_server_field_resolver_externalAddressServices_hint">この機械の公開アドレスを順に尋ねる URL をカンマ区切りで。ドメインが公開すべき A レコードを埋めるのに使います。前のものが答えなかったときだけ次に尋ねます。</string>
    <string name="settings_server_field_resolver_nameserver">リゾルバ</string>
    <string name="settings_server_field_resolver_nameserver_hint">host:port の形式で、たとえば 1.1.1.1:53。空ならこの機械の設定に従います。キャッシュの強いリゾルバでは、公開したばかりのレコードがその間ずっと未公開に見えます。</string>
    <string name="settings_server_field_route53_accessKeyId">アクセスキー ID</string>
    <string name="settings_server_field_route53_enabled">有効にしました</string>
    <string name="settings_server_field_route53_region">リージョン</string>
    <string name="settings_server_field_route53_secretAccessKey">シークレットアクセスキー</string>
    <string name="settings_server_field_route53_zoneId">ホストゾーン ID</string>
    <string name="settings_server_field_s3_accessKeyId">アクセスキー ID</string>
    <string name="settings_server_field_s3_bucket">バケット</string>
    <string name="settings_server_field_s3_enabled">有効にしました</string>
    <string name="settings_server_field_s3_endpoint">エンドポイント</string>
    <string name="settings_server_field_s3_endpoint_hint">AWS 以外の S3 互換サービス。AWS を使う場合は空のままにします。</string>
    <string name="settings_server_field_s3_pathStyle">エンドポイント/バケット の形式で指定する</string>
    <string name="settings_server_field_s3_region">リージョン</string>
    <string name="settings_server_field_s3_secretAccessKey">シークレットアクセスキー</string>
    <string name="settings_server_field_session_lifetime">セッションの有効期間</string>
    <string name="settings_server_field_session_lifetime_hint">720h や 30d のように書きます。短くしても、すでに発行済みのセッションは終わりません。作られた時点の期間が刻まれているためです。それらはアカウントの「セッション」ページで終了できます。</string>
    <string name="settings_server_field_smtp_authRateBurst">一度に許す試行</string>
    <string name="settings_server_field_smtp_authRateBurst_hint">速度制限が効き始めるまでに許される失敗の回数です。自分のパスワードを打ち間違えた人が引っかかるべきではありません。</string>
    <string name="settings_server_field_smtp_authRateLimit">毎分のサインイン試行</string>
    <string name="settings_server_field_smtp_authRateLimit_hint">一つのアドレスがどれだけ速く失敗すると速度制限がかかるか。弱いパスワードと、順に試している相手との間に立つのはこれだけです。</string>
    <string name="settings_server_field_smtp_greylistDelay">グレイリストの待機</string>
    <string name="settings_server_field_smtp_greylistDelay_hint">初めて見る送信元にどれだけ待ってから再試行してもらうか。5m や 0s のように書きます。まともなメールサーバーは再試行します。しないものは受け取る価値がないことがほとんどです。0s で無効になります。</string>
    <string name="settings_server_field_smtp_maxMessageSize">メール一通の上限</string>
    <string name="settings_server_field_smtp_maxMessageSize_hint">設定ファイルと同じく単位を付けます：50MB、25MiB、10485760。これを超えるメールは受信の途中で拒否されるので、送信側は理由を知らされます。</string>
    <string name="settings_server_field_smtp_maxRecipientsIncoming">受信一通あたりの宛先数</string>
    <string name="settings_server_field_smtp_maxRecipientsIncoming_hint">届いた一通が指定できる宛先の数で、超えた分は拒否されます。こちらの複数のアドレスに一度に届く一通は、たいてい誰かがアドレスを推測しています。</string>
    <string name="settings_server_field_smtp_maxRecipientsOutgoing">送信一通あたりの宛先数</string>
    <string name="settings_server_field_smtp_maxRecipientsOutgoing_hint">自分の端末が投稿するメールについても同じです。一度の間違いがどこまで広がりうるかの上限になります。</string>
    <string name="settings_server_field_smtp_trustedSenders">信頼する送信元</string>
    <string name="settings_server_field_smtp_trustedSenders_hint">カンマ区切りのアドレスまたは範囲（10.0.0.0/8 や 192.168.1.5 など）。見知らぬ相手が受ける検査を省きます。ここに書いたものは誰にでもなりすませるので、自分の機器だけにしてください。</string>
    <string name="settings_server_field_storage_directory">メールのディレクトリ</string>
    <string name="settings_server_field_storage_directory_hint">データディレクトリの下です。変えても既にあるものは移らないので、古い方のメールはダッシュボードから読めなくなります。</string>
    <string name="settings_server_field_storage_spoolRetention">再試行を続ける期間</string>
    <string name="settings_server_field_storage_spoolRetention_hint">30d や 72h のように書きます。失敗し続ける配送を、諦めて差し戻すまでキューに置く期間です。</string>
</resources>
