    <string name="mail_manage_dns_records_footer">Publish these with whoever runs DNS for this domain. Until the MX record is right, no mail arrives here at all.</string>
    <string name="mail_manage_logo_requirements_footer">It has to be an SVG of the restricted kind BIMI accepts: no script, no animation, nothing fetched from elsewhere, and square. This checks that before publishing it, and says what is wrong if anything is.</string>
    <string name="mail_manage_logo_certificate_footer">Gmail and Yahoo need a certificate. They show a mark only for senders who also hold a Verified Mark Certificate, which is issued against a registered trademark, renewed yearly, and costs on the order of a thousand dollars. Other receivers show one without. Its address goes in the record as the a= tag once you have one.</string>
    <string name="mail_manage_mail_server_names">Mail server names</string>
    <string name="mail_manage_save_names">Save the names</string>
    <string name="mail_manage_mail_servers_footer">The names this domain’s MX records point at, and so the names a sender connects to. Leave this empty for the default, one name derived from the domain.</string>
    <string name="mail_manage_mail_servers_current_footer">Comma separated. Currently %1$s. A name inside this domain is one you publish an address record for, and one this server can obtain a certificate for; a name outside it belongs to whoever owns that zone.</string>
    <string name="mail_manage_pictures_in_mail">Pictures in mail</string>
    <string name="mail_manage_host_for_pictures">Host for pictures</string>
    <string name="mail_manage_link_host_footer">A picture you put in a template is fetched by the reader’s mail program over HTTPS, from a name under this domain. That is a different question from where mail arrives: the host a mail server name points at may answer HTTPS with something else entirely, and then the mail is fine while every picture in it is broken.</string>
    <string name="mail_manage_link_host_default_footer">Leave it empty to use %1$s. Whatever you name has to reach this server over HTTPS with a certificate a mail program will accept, and has to be under this domain: an address in another domain tells every reader who runs the server.</string>
    <string name="mail_manage_signing_key">Signing key</string>
    <string name="mail_manage_signing_key_signed">Mail sent from this domain is signed under the selector %1$s. The public half is the TXT record above; the private half is kept in this server’s database and never leaves it.</string>
    <string name="mail_manage_signing_key_missing">This domain has no signing key, so its outgoing mail is unsigned and receivers are likely to treat it as spam.</string>
    <string name="mail_manage_selector">Selector</string>
    <string name="mail_manage_move_selector">Move the selector</string>
    <string name="mail_manage_move_selector_question">Publish the key under a different label?</string>
    <string name="mail_manage_move_selector_message">Mail is signed under the new label from the moment this is saved, so publish the record at %1$s first. Until you do, signatures from this domain cannot be verified.</string>
    <string name="mail_manage_selector_moved">Selector moved</string>
    <string name="mail_manage_replace_key">Replace the key</string>
    <string name="mail_manage_replace_key_question">Replace the signing key?</string>
    <string name="mail_manage_replace_key_message">Mail already sent and signed with the old key stops verifying as soon as you change the DNS record, so do this only when rotating.</string>
    <string name="mail_manage_key_replaced">Key replaced</string>
    <string name="mail_manage_generate_key">Generate a key</string>
    <string name="mail_manage_key_generated">Key generated</string>
    <string name="mail_manage_signing_key_footer">The label the key is published under. It only has to be unique within this domain, and the record goes at %1$s.</string>
    <string name="mail_manage_queue_empty_description">Every delivery has either succeeded or been given up on.</string>
    <string name="mail_manage_no_reports_description">No aggregate reports have arrived yet. They come from receiving servers that see mail claiming to be from your domains, and only if a domain publishes a DMARC record asking for them. Expect the first within a day or two of publishing one.</string>
    <string name="mail_manage_classifier_contributing">The classifier is contributing, with %1$d learned.</string>
    <string name="mail_manage_classifier_silent">The classifier stays silent until %1$d are learned; it has %2$d.</string>
    <string name="mail_manage_no_source_rows">This report carried no per-source rows, which usually means the original XML could not be parsed.</string>
    <string name="mail_manage_aliases_footer">An alias with an empty pattern is a catch-all: it receives whatever no other alias matched.</string>
    <string name="mail_manage_alias_catch_all">(catch-all)</string>
    <string name="mail_manage_alias_pattern_prompt">^hello$, or leave blank to catch everything else</string>
    <string name="mail_manage_alias_pattern_missing">This address needs a pattern. To catch everything else, add an alias with an empty pattern.</string>
    <string name="mail_manage_alias_disabled_footer">A disabled alias is ignored, as if it were not there. It stays so it can be turned back on.</string>
    <string name="mail_manage_credentials_footer">For sending mail through this server as %1$s, from a mail client or a script.</string>
