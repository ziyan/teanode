    <string name="mail_manage_templates_footer">A template is a message this domain sends by name: an application calls the send endpoint with the name and the values. Each can be translated into as many languages as its readers speak.</string>
    <string name="mail_manage_layouts">Layouts</string>
    <string name="mail_manage_no_layouts">No layouts. A template with no layout renders on its own, which is fine for plain messages.</string>
    <string name="mail_manage_layouts_footer">A layout is what goes around a template: the header, the footer, the styles.</string>
    <string name="mail_manage_written_on_dashboard">Templates and layouts are written and changed on the dashboard.</string>
    <string name="mail_manage_remove_template_question">Remove the template %1$s?</string>
    <string name="mail_manage_remove_template_message">Anything sending it by name stops working at once. Mail already sent is unaffected.</string>
    <string name="mail_manage_remove_layout_question">Remove this layout?</string>
    <string name="mail_manage_remove_layout_used">%1$d templates sit in it. They keep working, rendered without a layout, until you choose another.</string>
