// What every build of the app shares.
//
// The bundle identifier and the team belong to whoever signs the build. The
// published app is signed by the project's developer account; a person who
// builds it under their own account sets theirs in Identity.xcconfig, which
// is not committed (copy Identity.example.xcconfig). A simulator build needs
// neither.

TEANODE_BUNDLE_IDENTIFIER = com.teanode.app

// The keychain group the app and its notification extension share: the
// sign-in and the key notifications are encrypted with.
TEANODE_KEYCHAIN_GROUP = $(TEANODE_BUNDLE_IDENTIFIER).shared

// Recording imports must outlive the share extension and reach the app upload queue.
TEANODE_APP_GROUP = group.$(TEANODE_BUNDLE_IDENTIFIER)

// The app and its extensions carry the same version; CI sets the build
// number of each upload.
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Automatic

#include? "Identity.xcconfig"
