      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ になりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 现在%2$@"
          }
