{
  "sourceLanguage": "en",
  "strings": {
    "%@ in, %@ out · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力 %1$@、出力 %2$@ · %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %1$@，输出 %2$@ · %3$@"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ removed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を削除しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删除 %@"
          }
        }
      }
    },
    "%@ saved": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存 %@"
          }
        }
      }
    },
    "%@, %lld events": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、予定 %2$lld 件"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld 个日程"
          }
        }
      }
    },
    "%lld earlier messages": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以前のメッセージ %lld 件"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 条更早的消息"
          }
        }
      }
    },
    "(no title)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "（タイトルなし）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（无标题）"
          }
        }
      }
    },
    "5 days": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5日間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "5 天"
          }
        }
      }
    },
    "A coding session asks you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングセッションからの質問"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个编程会话在问你"
          }
        }
      }
    },
    "A coding session finished": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングセッションが終わりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个编程会话完成了"
          }
        }
      }
    },
    "A goal needs you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標があなたを必要としています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个目标需要你"
          }
        }
      }
    },
    "A tool call could not be read, so it was asked for again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れないツール呼び出しがあったため、もう一度依頼しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一个工具调用无法读取，已重新请求。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Add a reminder with +, or ask your agent to remind you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ でリマインダーを追加するか、エージェントに頼んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点 + 添加提醒，或让你的助手提醒你。"
          }
        }
      }
    },
    "Add email": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加邮箱"
          }
        }
      }
    },
    "Add files": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加文件"
          }
        }
      }
    },
    "Add one with +, or save a sender from a message.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "+ で追加するか、メッセージの送信者を保存してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点 + 添加，或从邮件中保存发件人。"
          }
        }
      }
    },
    "Add phone": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "電話番号を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加电话"
          }
        }
      }
    },
    "Add pictures": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图片"
          }
        }
      }
    },
