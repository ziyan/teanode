          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开"
          }
        }
      }
    },
    "On %@, %@ wrote:": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@、%2$@ のメッセージ："
