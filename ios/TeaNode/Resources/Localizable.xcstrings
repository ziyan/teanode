        }
      }
    },
    "Summaries": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要"
          }
        }
      }
    },
    "Summarize conversations": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を要約する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总结会话"
          }
        }
      }
    },
    "Summary": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "要約"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "摘要"
          }
        }
      }
    },
    "Survey": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "調査"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "调查"
          }
        }
      }
    },
    "Surveys and subagents your agent started without waiting for them, and surveys started from the command line. The conversation that started one hears when it finishes.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが待たずに始めた調査とサブエージェント、およびコマンドラインから始めた調査です。始めた会話は、終わったときに知らされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手未等待就开始的调查和子代理，以及从命令行开始的调查。开始它的对话会在它完成时得知。"
          }
        }
      }
    },
    "Switched off by your administrator. It stays off until they lift that.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者により停止されています。解除されるまで無効のままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已被管理员关闭。在管理员解除前保持关闭。"
          }
        }
      }
    },
    "Sync": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步"
          }
        }
      }
    },
    "Synced": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期あり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已同步"
          }
        }
      }
    },
    "Synced %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に同期"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已同步"
          }
        }
      }
    },
    "Syncing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同期中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在同步"
          }
        }
      }
    },
    "System": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跟随系统"
          }
        }
      }
    },
    "Take %@ away from the agent? Queued work for it is cancelled; what it has sorted stays.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をエージェントから外しますか？待機中の作業は取り消され、仕分け済みのものは残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收回 %@？排队中的工作会取消；已整理的内容保留。"
          }
        }
      }
    },
    "Take off this charge": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この支払いから外す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这笔扣款移除"
          }
        }
      }
    },
    "Taken off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已移除"
          }
        }
      }
    },
    "Talk to your agent from your phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンからエージェントと話せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上和你的助手交谈。"
          }
        }
      }
    },
    "Talk to your agent's main chat from Telegram or Discord, through a bot of your own. Make the bot in the app, paste its token here, then send the bot the code shown to link that chat. Only the linked chat reaches your agent; it types while it works, sends what it makes, takes files and photos, and asks on the same cards the drawer shows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のボットを通じて、Telegram や Discord からエージェントのメインチャットと話せます。アプリでボットを作り、そのトークンをここに貼り付け、表示されたコードをボットに送ってそのチャットを結び付けます。結び付けたチャットだけがエージェントに届き、作業中は入力中と表示し、作ったものを送り、ファイルや写真を受け取り、ドロワーと同じカードで確認を求めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过你自己的机器人，在 Telegram 或 Discord 中与助手的主聊天交谈。在应用里创建机器人，把它的令牌粘贴到这里，然后把显示的代码发给机器人以关联该聊天。只有关联的聊天能联系到你的助手；它工作时会显示正在输入，发送它制作的内容，接收文件和照片，并用抽屉里同样的卡片向你确认。"
          }
        }
      }
    },
    "Talks with you in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话语言"
          }
        }
      }
    },
    "Taxes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "税金"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "税费"
          }
        }
      }
    },
    "TeaNode": {
      "shouldTranslate": false
    },
    "TeaNode cannot use the camera": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode はカメラを使えません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode 无法使用相机"
          }
        }
      }
    },
    "TeaNode may not use the microphone. Allow it in Settings, then call again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode はマイクを使えません。設定で許可してから、もう一度かけてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode 无法使用麦克风。请在“设置”中允许后再拨打。"
          }
        }
      }
    },
    "Team lunch": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チームランチ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队午餐"
          }
        }
      }
    },
    "Telegram": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram ボット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram 机器人"
          }
        }
      }
    },
    "Tell it something": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伝えたいこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉它一些事"
          }
        }
      }
    },
    "Tell me about what arrives here that I should know now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに届いた、今知っておくべきことを伝える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里收到的、我现在就该知道的事告诉我"
          }
        }
      }
    },
    "Tell me what my mail says I should know now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今知っておくべきメールの内容を伝える"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉我邮件里我现在就该知道的事"
          }
        }
      }
    },
    "Tell this phone about": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンに知らせる内容"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知这部手机的内容"
          }
        }
      }
    },
    "Test": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "测试"
          }
        }
      }
    },
    "That card was already answered, or is no longer waiting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードはすでに回答済みか、もう待っていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张卡片已被回答，或已不再等待。"
          }
        }
      }
    },
    "That contact could not be read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連絡先を読み込めませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该联系人"
          }
        }
      }
    },
    "That did not reach your agent: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに届きませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能送到助手：%@"
          }
        }
      }
    },
    "That did not work.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作未成功。"
          }
        }
      }
    },
    "That did not work: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有成功：%@"
          }
        }
      }
    },
    "That event could not be read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この予定を読み込めませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该日程"
          }
        }
      }
    },
    "That is not a TeaNode connect code. Use the code on your dashboard's Connect a phone page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode の接続コードではありません。ダッシュボードの「スマートフォンを接続」ページのコードを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 TeaNode 连接码。请使用控制台“连接手机”页面上的二维码。"
          }
        }
      }
    },
    "That is not a server address.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーのアドレスではありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是服务器地址。"
          }
        }
      }
    },
    "That link has no code in it. Make a new one on your dashboard's Connect a phone page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクにはコードが含まれていません。ダッシュボードの「スマートフォンを接続」ページで新しいコードを作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个链接里没有连接码。请在控制台的“连接手机”页面生成一个新的。"
          }
        }
      }
    },
    "That turn failed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンは失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一轮失败了。"
          }
        }
      }
    },
    "The address of your TeaNode dashboard. Its sign-in page opens next.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode ダッシュボードのアドレス。次にそのサインインページが開きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 TeaNode 控制台地址。接下来会打开它的登录页面。"
          }
        }
      }
    },
    "The agent cannot reach this mailbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントはこのメールボックスに触れられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手无法访问此邮箱。"
          }
        }
      }
    },
    "The agent reading it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが読み取る"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手读取"
          }
        }
      }
    },
    "The agent says it needs a reply": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが返信が必要と判断"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手判断需要回复"
          }
        }
      }
    },
    "The agent's estimate": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの見積もり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手估算"
          }
        }
      }
    },
    "The agent's reply was cancelled": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの返信を取り消しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手的回复已取消"
          }
        }
      }
    },
    "The agent's steps": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの手順"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手的步骤"
          }
        }
      }
    },
    "The bot's token": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボットのトークン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "机器人的令牌"
          }
        }
      }
    },
    "The brief is off. The schedule is still there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリーフを停止しました。スケジュールは残っています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简报已关闭，日程仍保留。"
          }
        }
      }
    },
    "The brief is on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブリーフを開始しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "简报已开启。"
          }
        }
      }
    },
    "The browsers signed in to this account. Ending one signs that browser out; the others are untouched.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにサインインしているブラウザーです。一つを終了してもそのブラウザーだけがサインアウトされ、他はそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录此账号的浏览器。结束其中一个只会登出那个浏览器，其余不受影响。"
          }
        }
      }
    },
    "The call lost its connection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話の接続が切れました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话连接已断开。"
          }
        }
      }
    },
    "The camera is not available": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用相机"
          }
        }
      }
    },
    "The dream starts within the minute.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢は 1 分以内に始まります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "梦境整理会在一分钟内开始。"
          }
        }
      }
    },
    "The earlier chat was folded into a note.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまでのチャットはメモにまとめられました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的聊天已折叠成一份笔记。"
          }
        }
      }
    },
    "The files come to more than 25 MB, more than the server takes in one message.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの合計が 25 MB を超えており、サーバーが 1 通で受け取れる量を超えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件超过 25 MB，超出服务器一条消息能接收的大小。"
          }
        }
      }
    },
    "The hours of the day, in your zone, when a dream may start; it also waits until you have been away half an hour. The same time at both ends means any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの時間帯で、夢を見はじめてよい一日のうちの時間帯です。あなたが三十分ほど離れてから始まります。開始と終了が同じなら、いつでも。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按你所在时区，梦境整理可以在一天中的这段时间开始；它还会等到你离开半小时之后。开始和结束相同表示任何时候。"
          }
        }
      }
    },
    "The list says nothing about how to leave it. Muting keeps it out of the Inbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリストには解除方法の記載がありません。ミュートすると受信トレイに入らなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个列表没有说明如何退订。静音可以让它不进入收件箱。"
          }
        }
      }
    },
    "The mail program using it stops reaching the mailbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを使うメールアプリはメールボックスに接続できなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用它的邮件程序将无法再访问邮箱。"
          }
        }
      }
    },
    "The message answered is no longer stored, so the reply goes without a quote.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信元のメッセージは保存されていないため、引用なしで返信します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被回复的邮件已不再保存，因此回复中不含引用。"
          }
        }
      }
    },
    "The microphone could not be started: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを起動できませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动麦克风：%@"
          }
        }
      }
    },
    "The microphone gives no sound. Check that nothing else is using it, or try AirPods or the speaker.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクから音が入りません。ほかのアプリが使っていないか確認するか、AirPods やスピーカーを試してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风没有声音。请确认没有其他应用在使用它，或改用 AirPods 或扬声器。"
          }
        }
      }
    },
    "The microphone's format cannot be sent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクの音声形式を送信できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送麦克风的音频格式。"
          }
        }
      }
    },
    "The name stays when the app renews its access.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリがアクセスを更新しても名前は変わりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用续期访问权限时名称保持不变。"
          }
        }
      }
    },
    "The newest messages in the Inbox, and which of the rules above would match each. Nothing is moved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイの最新メッセージと、上のルールのどれが一致するか。実際には何も移動しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件箱里最新的邮件，以及上面哪些规则会匹配每一封。不会实际移动任何邮件。"
          }
        }
      }
    },
    "The operator has not enabled agents on this server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "運用者がこのサーバーでエージェントを有効にしていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运维者尚未在此服务器上启用助手。"
          }
        }
      }
    },
    "The pending change was stopped": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留中の変更を停止しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未完成的更改已停止"
          }
        }
      }
    },
    "The phones the TeaNode app is connected on, and what each is told about.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode アプリを接続したスマートフォンと、それぞれに知らせる内容です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已连接 TeaNode 应用的手机，以及每部手机会收到哪些通知。"
          }
        }
      }
    },
    "The question is dropped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問を除外しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已舍弃该问题。"
          }
        }
      }
    },
    "The question is saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問を保存しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问题已保存。"
          }
        }
      }
    },
    "The questions and approvals your agent waits on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが返事を待っている質問と承認。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手在等你回答的问题和批准。"
          }
        }
      }
    },
    "The reach could not be set.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "経由を設定できませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法设置经由。"
          }
        }
      }
    },
    "The reply will not be sent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この返信は送信されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这封回复不会发出。"
          }
        }
      }
    },
    "The runs it made": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行した処理"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它进行的运行"
          }
        }
      }
    },
    "The runs of the dream at %@: every call it made to a model, newest first. Open one to read it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の夢の実行記録：モデルへの呼び出しひとつひとつが、新しい順に並びます。開くと読めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 那次梦境整理的运行记录：它对模型的每一次调用，最新的在前。打开一条即可阅读。"
          }
        }
      }
    },
    "The runs your agent made on its own (sorting, answering, looking things up, its schedules), newest first. Open one to read what it did and ask about it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分で行った実行（仕分け、返信、調査、スケジュール）を新しい順に。開くと内容を読み、質問できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手自行完成的运行（分类、回复、查找、计划任务），最新在前。打开一条可阅读它做了什么并就此提问。"
          }
        }
      }
    },
    "The sender is told at once, the way the list asks to be left.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リストが求める方法で送信者にすぐ伝えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会按照列表要求的方式立即通知发件人。"
          }
        }
      }
    },
    "The sender's own page opens to finish leaving there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信者のページを開き、そこで解除を完了します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会打开发件人的页面，在那里完成退订。"
          }
        }
      }
    },
    "The server could not be reached. Check the connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。请检查网络后重试。"
          }
        }
      }
    },
    "The server did not accept the connection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーが接続を受け付けませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器没有接受这次连接。"
          }
        }
      }
    },
    "The server did not sign this phone in.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはこの電話をサインインさせませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器没有让这台手机登录。"
          }
        }
      }
    },
    "The server's (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの声（%@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的（%@）"
          }
        }
      }
    },
    "The server's choice": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーの既定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器的选择"
          }
        }
      }
    },
    "The share sheet, widgets and Siri use the account in use.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有、ウィジェット、Siri は使用中のアカウントを使います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分享、小组件和 Siri 使用正在使用的账户。"
          }
        }
      }
    },
    "The token itself stays the same, so whatever uses it keeps working.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トークン自体は変わらないので、使っているものはそのまま動きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌本身不变，使用它的程序会继续正常工作。"
          }
        }
      }
    },
    "The tools you listed to always ask about. Those the operator listed always wait for you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが常に確認するよう指定したツール。運用者が指定したものは常にあなたを待ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你列为总要先问的工具。运营者列出的工具总会等你确认。"
          }
        }
      }
    },
    "The turn failed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンは失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一轮失败了。"
          }
        }
      }
    },
    "The turn failed: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンは失敗しました：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一轮失败了：%@"
          }
        }
      }
    },
    "The voice your answers are read aloud in when you call your agent. You can also ask the agent to change it mid-call.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに電話したとき、回答を読み上げる声です。通話中にエージェントに変えてもらうこともできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给代理打电话时朗读回答所用的声音。通话中也可以让代理换一个。"
          }
        }
      }
    },
    "The way out was taken off the message on its way here. Muting keeps it out of the Inbox.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除方法は配送途中でメッセージから取り除かれました。ミュートすると受信トレイに入らなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退订方式在邮件送达途中被移除了。静音可以让它不进入收件箱。"
          }
        }
      }
    },
    "There is no page here": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにページはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有页面"
          }
        }
      }
    },
    "These do not match.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力が一致しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两次输入不一致。"
          }
        }
      }
    },
    "Things your agent does at set times, in your zone: a morning brief, a Friday round-up. A scheduled run can confirm nothing, so it only does what needs no confirmation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのタイムゾーンで、決まった時間にエージェントが行うこと。朝のまとめ、金曜の振り返りなど。予定実行では確認ができないため、確認の要らないことだけを行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手按你的时区在固定时间做的事：早间简报、周五总结。定时运行无法确认，所以只做无需确认的事。"
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考え中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "思考中…"
          }
        }
      }
    },
    "This account has no mailbox to set up on the phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントには電話で設定できるメールボックスがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个账户没有可以在手机上设置的邮箱。"
          }
        }
      }
    },
    "This browser": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このブラウザー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前浏览器"
          }
        }
      }
    },
    "This changes months already past.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の月が変わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会更改已经过去的月份。"
          }
        }
      }
    },
    "This conversation could not be read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話を読み込めませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这个对话"
          }
        }
      }
    },
    "This could not be read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込めませんでした"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取"
          }
        }
      }
    },
    "This deletes your agent and everything it learned: memories, conversations, run records, and every mailbox's insights and summaries. Your mail is untouched.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントと学んだことすべて（記憶、会話、実行記録、各メールボックスの分析と要約）を削除します。メールはそのままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会删除你的助手及其学到的一切：记忆、对话、运行记录，以及每个邮箱的洞察和摘要。你的邮件不受影响。"
          }
        }
      }
    },
    "This device only": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のみ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅此设备"
          }
        }
      }
    },
    "This document is no longer kept": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドキュメントはもう保存されていません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份文档已不再保存"
          }
        }
      }
    },
    "This grading has no answers.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この採点には回答がありません。"
          }
        },
