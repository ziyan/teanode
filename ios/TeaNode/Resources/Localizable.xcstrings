            "value": "查看"
          }
        }
      }
    },
    "No photos of this person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物の写真はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有这个人物的照片"
          }
        }
      }
    },
    "The file is in iCloud and this network costs data.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは iCloud にあり、このネットワークではデータ通信料がかかります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件在 iCloud 中，而当前网络会产生流量费用。"
          }
        }
      }
    },
    "Starting": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開始しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在开始"
          }
        }
      }
    },
    "Choose dates…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を選択…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日期…"
          }
        }
      }
    },
    "No photos in this album": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムに写真はありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个相簿里没有照片"
          }
        }
      }
    },
    "This iPhone's photos are backed up to a different account. Sign in as that account to turn it off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone の写真は別のアカウントにバックアップされています。オフにするには、そのアカウントでサインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 的照片备份到了另一个账户。请以该账户登录以将其关闭。"
          }
        }
      }
    },
    "Share album": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムを共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享相簿"
          }
        }
      }
    },
    "Change name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を変更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改名称"
          }
        }
      }
    },
    "Cannot show this photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を表示できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法显示这张照片"
          }
        }
      }
    },
    "%@ looks at the picture and writes what it shows, so a search can find it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が写真を見て内容を書き出すので、検索で見つけられるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会查看这张图片并写下其中的内容，这样搜索就能找到它。"
          }
        }
      }
    },
    "Photo backup is on for %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ で写真のバックアップがオンになっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %@ 开启照片备份。"
          }
        }
      }
    },
    "Saved to your library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存到你的图库"
          }
        }
      }
    },
    "Saved the edited version to the Photos app": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集済みを「写真」App に保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将编辑后的版本保存到“照片”App"
          }
        }
      }
    },
    "Photo backup": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のバックアップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片备份"
          }
        }
      }
    },
    "Photos you add to your library can be added to the album.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに追加した写真をこのアルバムに追加できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到你图库的照片可以加入这个相簿。"
          }
        }
      }
    },
    "Not this person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物ではない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是这个人"
          }
        }
      }
    },
    "Days are counted on this iPhone's clock, so a photo taken in another time zone can fall on a neighboring day.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付はこの iPhone の時刻で数えるため、別のタイムゾーンで撮影した写真は前後の日になることがあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期按这部 iPhone 的时间计算，因此在其他时区拍摄的照片可能会落在相邻的一天。"
          }
        }
      }
    },
    "Photos you move to the Trash stay here for a while before they are deleted forever.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れた写真は、完全に削除されるまでしばらくここに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移到废纸篓的照片会在此保留一段时间，之后将被永久删除。"
          }
        }
      }
    },
    "Show hidden": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非表示を表示"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示已隐藏的"
          }
        }
      }
    },
    "Saving to the Photos app": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「写真」App に保存中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在保存到“照片”App"
          }
        }
      }
    },
    "%@ on %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，位于 %2$@"
          }
        }
      }
    },
    "Find faces in my photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真から顔を見つける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在我的照片中查找人脸"
          }
        }
      }
    },
    "Ready to back up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップの準備ができました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以开始备份"
          }
        }
      }
    },
    "Not %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ではない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是%@"
          }
        }
      }
    },
    "This iPhone stops backing up and its backup password is revoked. Photos already on TeaNode stay there.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone はバックアップを停止し、バックアップ用パスワードは取り消されます。すでに TeaNode にある写真はそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 将停止备份，其备份密码会被撤销。已经在 TeaNode 上的照片会保留。"
          }
        }
      }
    },
    "The server did not accept this iPhone's backup password.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがこの iPhone のバックアップ用パスワードを受け付けませんでした。"
          }
