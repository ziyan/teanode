        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏已退出的会话"
          }
        }
      }
    },
    "High": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高"
          }
        }
      }
    },
    "High priority": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "優先度高"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高优先级"
          }
        }
      }
    },
    "History": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "履歴"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史"
          }
        }
      }
    },
    "Hold for (minutes)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保留（分）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留（分钟）"
          }
        }
      }
    },
    "Home": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住まい"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "家居"
          }
        }
      }
    },
    "Housing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住居"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "住房"
          }
        }
      }
    },
    "How far back, in minutes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何分前までさかのぼるか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回溯多少分钟"
          }
        }
      }
    },
    "How it compares": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "比較方法"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比较方式"
          }
        }
      }
    },
    "How it sounds when it writes for you: replies it drafts and answers it sends.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの代わりに書くときの口調。下書きする返信と、代わりに送る返答に使われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它替你写作时的语气：起草的回复，以及代你发出的回信。"
          }
        }
      }
    },
    "How often to read it, as a cron line": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのくらいの頻度で読むか（cron 形式）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多久读取一次（cron 格式）"
          }
        }
      }
    },
    "How your agent scored in each grading, answering from what it remembers, from your sources, and from both. A partial answer counts as half.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各採点でのエージェントのスコア。記憶から、ソースから、その両方から答えた場合です。部分的な答えは半分として数えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次评分中你的助手的得分，分别是凭记忆、凭来源、以及两者结合作答。部分正确的答案算一半。"
          }
        }
      }
    },
    "I am addressed directly": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私宛てのとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "直接发给我时"
          }
        }
      }
    },
    "I need your approval on screen: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面で承認が必要です：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你在屏幕上批准：%@"
          }
        }
      }
    },
    "Ideas": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アイデア"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想法"
          }
        }
      }
    },
    "Important": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重要"
          }
        }
      }
    },
    "In Telegram, open @BotFather, send /newbot, and paste the token it gives you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram で @BotFather を開き、/newbot を送って、渡されたトークンを貼り付けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Telegram 中打开 @BotFather，发送 /newbot，然后粘贴它给出的令牌。"
          }
        }
      }
    },
    "In a directory (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディレクトリ内（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某个目录中（可选）"
          }
        }
      }
    },
    "In use": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在使用"
          }
        }
      }
    },
    "In your quiet hours only what cannot wait is said; the rest waits for the morning. The same time at both ends means no quiet hours.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな時間帯には待てないことだけを伝え、それ以外は朝まで待ちます。開始と終了が同じなら静かな時間帯はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安静时段只说等不了的事，其余的等到早上再说。开始和结束相同表示没有安静时段。"
          }
        }
      }
    },
    "Inbox": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件箱"
          }
        }
      }
    },
    "Income": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "収入"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收入"
          }
        }
      }
    },
    "Incoming (IMAP)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信（IMAP）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收信（IMAP）"
          }
        }
      }
    },
    "Into the conversation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送到对话里"
          }
        }
      }
    },
    "Invented": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作り話"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编造"
          }
        }
      }
    },
    "Investments": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投資"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投资"
          }
        }
      }
    },
    "Invitations go out by mail when the event is saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を保存すると招待がメールで送られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存日程时会通过邮件发送邀请。"
          }
        }
      }
    },
    "Invited": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待者"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受邀者"
          }
        }
      }
    },
    "It can no longer read this.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読めなくなりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不能再读取了。"
          }
        }
      }
    },
    "It can read this now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読めるようになりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在它可以读取了。"
          }
        }
      }
    },
    "It did not say why.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由は示されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有说明原因。"
          }
        }
      }
    },
    "It finished without saying anything.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も返さずに終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它结束了，但没有返回任何内容。"
          }
        }
      }
    },
    "It goes to your main conversation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインの会話に届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会发到你的主对话里。"
          }
        }
      }
    },
    "It has decided against nothing here yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではまだ何も見送っていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在这里还没有否决过任何文件。"
          }
        }
      }
    },
    "It is back among the open ideas.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているアイデアに戻しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已放回待选的想法中。"
          }
        }
      }
    },
    "It is in Schedules below, as \"Daily brief\".": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のスケジュールに「Daily brief」としてあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在下面的日程中，名为“Daily brief”。"
          }
        }
      }
    },
    "It is removed from your address book and from every device that reads it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス帳と、それを読むすべてのデバイスから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你的通讯录以及所有读取通讯录的设备中移除。"
          }
        }
      }
    },
    "It is removed from your calendar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你的日历中移除。"
          }
        }
      }
    },
    "It is shown this once. Type it into the mail program now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示は一度だけです。今メールアプリに入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它只会显示这一次，请现在输入到邮件程序中。"
          }
        }
      }
    },
    "It reads this at its next turn.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のターンで読みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在下一次运行时读到。"
          }
        }
      }
    },
    "It takes no more turns. You can reopen it later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これ以上ターンを取りません。後で再開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将不再运行。你之后可以重新开启。"
          }
        }
      }
    },
    "Its %lld messages are deleted with it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中の %lld 件のメッセージも削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的 %lld 封邮件也会被删除。"
          }
        }
      }
    },
    "Its %lld values go with it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の評価額も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 %lld 条估值也会一并删除。"
          }
        }
      }
    },
    "Its accounts and transactions are deleted from TeaNode. For SimpleFIN, also revoke the access on its site.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その口座と取引は TeaNode から削除されます。SimpleFIN の場合はそのサイトでもアクセスを取り消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其账户和交易会从 TeaNode 删除。对于 SimpleFIN，也请在其网站撤销访问权限。"
          }
        }
      }
    },
    "Its picture and lines are deleted too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像と明細も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其图片和明细也会被删除。"
          }
        }
      }
    },
    "Its transactions become uncategorized, and its budget and rules are deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その取引は未分類になり、予算とルールは削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其交易会变为未分类，预算和规则也会被删除。"
          }
        }
      }
    },
    "Jump to the end": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到末尾"
          }
        }
      }
    },
    "Junk": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷惑メール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾邮件"
          }
        }
      }
    },
    "Keep as it is (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま（%@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持不变（%@）"
          }
        }
      }
    },
    "Kept out of the Inbox": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイに入れないようにしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再进入收件箱"
          }
        }
      }
    },
    "Kept sealed on the server and sent only to the computer that reads this source; it is never shown again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに封をして保存され、このソースを読むコンピューターにだけ送られます。二度と表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密封保存在服务器上，只发送给读取此来源的电脑，之后不再显示。"
          }
        }
      }
    },
    "Kept your %@ for %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 用の %1$@ を保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存你用于 %2$@ 的 %1$@"
          }
        }
      }
    },
    "Kept; type here to replace it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済み。ここに入力すると置き換えます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存；在此输入可替换"
          }
        }
      }
    },
    "Kids": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "子ども"
          }
        },
        "zh-Hans": {
