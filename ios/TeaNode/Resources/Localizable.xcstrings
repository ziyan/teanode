            "value": "来自 %@ 的邮件"
          }
        }
      }
    },
    "Mail is signed under the new label from the moment this is saved, so publish the record at %@ first. Until you do, signatures from this domain cannot be verified.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存した時点から新しいラベルで署名されるため、先に %@ のレコードを公開してください。それまでこのドメインの署名は検証できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存后邮件立即改用新标签签名，因此请先发布 %@ 处的记录。在此之前，该域名的签名无法被验证。"
          }
        }
      }
    },
    "Mail programs": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールアプリ"
          }
        },
        "zh-Hans": {
