        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，端口 %2$@，STARTTLS"
          }
        }
      }
    },
    "%@ publishes no SPF record, so %@ could not be checked": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は SPF レコードを公開しておらず、%2$@ を確認できません"
