            "state": "translated",
            "value": "也叫 %@"
          }
        }
      }
    },
    "Also reached at": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかに到達するアドレス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他可达地址"
          }
        }
      }
    },
    "Always": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "总是"
          }
        }
      }
    },
    "Always for this merchant": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この店舗は常にこれ"
          }
        },
        "zh-Hans": {
