{
  "sourceLanguage": "en",
  "strings": {
    "%@ (bill: %@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@(請求額: %2$@)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（账单：%2$@）"
          }
        }
      }
    },
    "\"Confirm appointments and answer simple questions about opening hours; anything about money, wait for me.\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「予約の確認と営業時間についての簡単な質問には答える。お金に関することは私を待つ。」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"确认预约并回答关于营业时间的简单问题；涉及金钱的一律等我。\""
          }
        }
      }
    },
    "#%lld %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@"
          }
        }
      }
    },
    "#%lld %@ · folded into #%lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@ · #%3$lld に統合"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@ · 已并入 #%3$lld"
          }
        }
      }
    },
    "%@ %@ @ %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ @ %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ @ %3$@"
          }
        }
      }
    },
    "%@ %@ since %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ から %1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@，自 %3$@ 起"
          }
        }
      }
    },
    "%@ (missing)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（見つかりません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（缺失）"
          }
        }
      }
    },
    "%@ authorizes %@ to send for it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ からの送信を許可しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 授权 %2$@ 为其发信"
          }
        }
      }
    },
    "%@ available": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用可能 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@"
          }
        }
      }
    },
    "%@ dead": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件失敗"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个失败"
          }
        }
      }
    },
    "%@ did not accept the sign-in it gave this phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は、このスマートフォンに渡したばかりのサインインを受け付けませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 不接受它刚给这部手机的登录。"
          }
        }
      }
    },
    "%@ did not answer, so their sessions are not listed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ から応答がないため、そのセッションは表示されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有响应，因此没有列出它们的会话。"
          }
        }
      }
    },
    "%@ does not authorize %@ to send for it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ からの送信を許可していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未授权 %2$@ 为其发信"
          }
        }
      }
    },
    "%@ does not list %@, but asks that mail from it be accepted anyway": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ を列挙していませんが、受け入れるよう求めています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 未列出 %2$@，但请求仍接收来自它的邮件"
          }
        }
      }
    },
    "%@ for %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 的 %1$@"
          }
        }
      }
    },
    "%@ from %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@（%2$@ から）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，来自 %2$@"
          }
        }
      }
    },
    "%@ from %@, so far": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@年（%2$@から今日まで）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@年（自%2$@起至今）"
          }
        }
      }
    },
    "%@ has to be a whole number": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は整数にしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须是整数"
          }
        }
      }
    },
    "%@ has to be at least %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$lld 以上にしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不能小于 %2$lld"
          }
        }
      }
    },
    "%@ has to be at most %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$lld 以下にしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不能大于 %2$lld"
          }
        }
      }
    },
    "%@ in / %@ out per million tokens": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100万トークンあたり 入力 %@ / 出力 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每百万 token：输入 %@ / 输出 %@"
          }
        }
      }
    },
    "%@ in, %@ out · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力 %1$@、出力 %2$@ · %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %1$@，输出 %2$@ · %3$@"
          }
        }
      }
    },
    "%@ is installed but not offered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はインストール済みですが提供していません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已安装但未启用"
          }
        }
      }
    },
    "%@ is not in the form it asks for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の形式が違います"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的格式不对"
          }
        }
      }
    },
    "%@ is off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はオフです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已关闭"
          }
        }
      }
    },
    "%@ is offered again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を再び提供します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已重新启用"
          }
        }
      }
    },
    "%@ is signed out of TeaNode and told nothing more. Connect it again to use it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は TeaNode からサインアウトされ、以後何も届きません。使うにはもう一度接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将退出 TeaNode，不再收到任何通知。要再次使用，请重新连接。"
          }
        }
      }
    },
    "%@ is the newest release": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が最新です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已是最新版"
          }
        }
      }
    },
    "%@ less": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 少ない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "少 %@"
          }
        }
      }
    },
    "%@ messages learned, contributing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 通を学習済み、スコアに反映中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已学习 %@ 封，正在参与评分"
          }
        }
      }
    },
    "%@ models priced apart": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 件のモデルを個別に価格設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个模型单独计价"
          }
        }
      }
    },
    "%@ models, for example %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 個のモデル。例: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 个模型，例如 %@"
          }
        }
      }
    },
    "%@ more": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 多い"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多 %@"
          }
        }
      }
    },
    "%@ needs a value": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に値が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要一个值"
          }
        }
      }
    },
