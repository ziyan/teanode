          "stringUnit": {
            "state": "translated",
            "value": "允许使用通行密钥登录"
          }
        }
      }
    },
    "Allow the camera for TeaNode in Settings to take a picture.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を撮るには、設定で TeaNode にカメラを許可してください。"
          }
        },
        "zh-Hans": {
