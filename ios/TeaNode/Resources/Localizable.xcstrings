            "value": "已经连接"
          }
        }
      }
    },
    "Already in TeaNode": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode に登録済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在 TeaNode 中"
          }
        }
      }
    },
    "Already in your contacts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに連絡先にあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在你的联系人中"
          }
        }
      }
    },
    "Also called %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
