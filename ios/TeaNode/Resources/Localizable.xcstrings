    "Voice reference curation pending": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待筛选声音参考"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声参照の選択待ち"
          }
        }
      }
    },
    "Learning uses the existing knowledge and dreaming pipeline without an approval step. Processed passages show source progress, not proof of useful memories.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "学习使用现有知识和梦境流程，无需批准步骤。已处理片段表示资料处理进度，并非有效记忆的证明。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "学習は既存の知識とドリーミングの処理を使い、承認は不要です。処理済みの発言は資料の進捗を示し、有用な記憶ができた証拠ではありません。"
          }
        }
      }
    },
    "Managed from the recording library": {
      "localizations": {
