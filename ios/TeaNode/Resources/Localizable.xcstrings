{
  "sourceLanguage": "en",
  "strings": {
    "A coding session asks you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングセッションからの質問"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个编程会话在问你"
          }
        }
      }
    },
    "A coding session finished": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングセッションが終わりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个编程会话完成了"
          }
        }
      }
    },
    "A goal needs you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標があなたを必要としています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个目标需要你"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "Account": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "Add pictures": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加图片"
          }
        }
      }
    },
    "Alert from your mail": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールからのお知らせ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自邮件的提醒"
          }
        }
      }
    },
    "Allow TeaNode to use the camera in Settings, or paste the code's link instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で TeaNode にカメラの使用を許可するか、コードのリンクを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 TeaNode 使用相机，或改为粘贴二维码的链接。"
          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已回答"
          }
        }
      }
    },
    "Approve?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要批准吗？"
          }
        }
      }
    },
    "Approved": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已同意"
          }
        }
      }
    },
    "Approved after the turn ended": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン終了後に承認しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在回合结束后批准"
          }
        }
      }
    },
    "Ask your agent anything: your mail, your calendar, a picture of a receipt.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール、カレンダー、レシートの写真など、何でもエージェントに尋ねられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以问助手任何事：你的邮件、日历，或一张收据的照片。"
          }
        }
      }
    },
    "Ask your agent…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに尋ねる…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问助手…"
          }
        }
      }
    },
    "Background command ended": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドのコマンドが終了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台命令已结束"
          }
        }
      }
    },
    "Background work finished": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックグラウンドの作業が完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台工作已完成"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Cannot load conversations": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話を読み込めません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法加载对话"
          }
        }
      }
    },
    "Cannot reach your agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに接続できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法联系到你的助手"
          }
        }
      }
    },
    "Connect": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接"
          }
        }
      }
    },
    "Connect this phone to your TeaNode server with a code from its dashboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュボードのコードで、このスマートフォンを TeaNode サーバーに接続します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用控制台上的连接码，把这部手机连接到你的 TeaNode 服务器。"
          }
        }
      }
    },
    "Connect to %@?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に接続しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接到 %@？"
          }
        }
      }
    },
    "Connecting…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在连接…"
          }
        }
      }
    },
    "Conversations": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话"
          }
        }
      }
    },
    "Declined": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "却下"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已拒绝"
          }
        }
      }
    },
    "Declined after the turn ended": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターン終了後に却下しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在回合结束后拒绝"
          }
        }
      }
    },
    "Do it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去做"
          }
        }
      }
    },
    "Done": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成"
          }
        }
      }
    },
    "Don’t": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やめる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要"
          }
        }
      }
    },
    "Goal check-in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標のターン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标回合"
          }
        }
      }
    },
    "New conversation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい会話"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新对话"
          }
        }
      }
    },
    "Not this one": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これではない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不是这个"
          }
        }
      }
    },
    "Nothing came back yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ結果がありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有返回结果。"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "On a computer, open your dashboard. In Settings, open Phones and choose Connect a phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンでダッシュボードを開き、「設定」の「スマートフォン」で「スマートフォンを接続」を選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开控制台，在“设置”中打开“手机”，选择“连接手机”。"
          }
        }
      }
    },
    "Only have this phone? Open your dashboard in Safari, copy the code's link, and paste it here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンしかない場合は、Safari でダッシュボードを開き、コードのリンクをコピーしてここに貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有这部手机？在 Safari 中打开控制台，复制二维码的链接，然后粘贴到这里。"
          }
        }
      }
    },
    "Or type your answer below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "または下に回答を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "也可以在下方输入你的回答。"
          }
        }
      }
    },
    "Remove picture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除图片"
          }
        }
      }
    },
    "Say something": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話しかけてみましょう"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说点什么"
          }
        }
      }
    },
    "Scan code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードをスキャン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描二维码"
          }
        }
      }
    },
    "Scan the code it shows.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示されたコードをスキャンします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描页面上显示的二维码。"
          }
        }
      }
    },
    "Scheduled turn": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュールのターン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定时回合"
          }
        }
      }
    },
    "Send": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发送"
          }
        }
      }
    },
    "Server": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器"
          }
        }
      }
    },
    "Settings": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置"
          }
        }
      }
    },
    "Sign out": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログアウト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出登录"
          }
        }
      }
    },
    "Sign out of TeaNode?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode からログアウトしますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出 TeaNode 登录？"
          }
        }
      }
    },
    "Signed in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインイン中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已登录"
          }
        }
      }
    },
    "Something went wrong": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題が発生しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出了点问题"
          }
        }
      }
    },
    "Started by the agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントから話しかけました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由助手主动发起"
          }
        }
      }
    },
    "Stop": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        }
      }
    },
    "Talk to your agent from your phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンからエージェントと話せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上和你的助手交谈。"
          }
        }
      }
    },
    "TeaNode": {
      "shouldTranslate": false
    },
    "That is not a TeaNode connect code. Use the code on your dashboard's Connect a phone page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode の接続コードではありません。ダッシュボードの「スマートフォンを接続」ページのコードを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 TeaNode 连接码。请使用控制台“连接手机”页面上的二维码。"
          }
        }
      }
    },
    "That link has no code in it. Make a new one on your dashboard's Connect a phone page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクにはコードが含まれていません。ダッシュボードの「スマートフォンを接続」ページで新しいコードを作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个链接里没有连接码。请在控制台的“连接手机”页面生成一个新的。"
          }
        }
      }
    },
    "The camera is not available": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用相机"
          }
        }
      }
    },
    "The server could not be reached. Check the connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。请检查网络后重试。"
          }
        }
      }
    },
    "This phone stops talking to your agent until you connect it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度接続するまで、このスマートフォンからエージェントと話せなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机将无法与助手交谈，直到你重新连接。"
          }
        }
      }
    },
    "This phone will be signed in as %@, and can do anything you can do on the dashboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは %@ としてサインインし、ダッシュボードでできることはすべてできるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机将以 %@ 的身份登录，可以做你在控制台上能做的任何事。"
          }
        }
      }
    },
    "To manage what this phone is told about, open Phones under Agent on your dashboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンに届く通知は、ダッシュボードの「エージェント」の「スマートフォン」で管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要管理这部手机接收哪些通知，请在控制台的“助手”下打开“手机”。"
          }
        }
      }
    },
    "Used %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
