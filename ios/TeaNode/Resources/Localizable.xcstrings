        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还有 %lld 条更早的消息"
          }
        }
      }
    },
    "A coding session asks you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングセッションからの質問"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个编程会话在问你"
          }
        }
      }
    },
    "A coding session finished": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コーディングセッションが終わりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个编程会话完成了"
          }
        }
      }
    },
    "A goal needs you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目標があなたを必要としています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有个目标需要你"
          }
        }
      }
    },
    "A tool call could not be read, so it was asked for again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れないツール呼び出しがあったため、もう一度依頼しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一个工具调用无法读取，已重新请求。"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアプリについて"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
