      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール配送"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件收发"
          }
        }
      }
    },
    "Mail sent from this domain is signed under the selector %@. The public half is the TXT record above; the private half is kept in this server’s database and never leaves it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このドメインから送るメールはセレクタ %@ で署名されます。公開鍵は上の TXT レコードで、秘密鍵はこのサーバーのデータベースに保存され、外に出ることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从该域名发出的邮件使用选择器 %@ 签名。公钥就是上面的 TXT 记录；私钥保存在此服务器的数据库中，不会离开这台服务器。"
          }
        }
      }
    },
