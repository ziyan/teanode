    "Tax for %@, by December 31": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 年の税金（12 月 31 日までの見込み）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 年的税（预计到 12 月 31 日）"
          }
        }
      }
    },
    "Tax for the year": {
      "localizations": {
        "ja": {
          "stringUnit": {
