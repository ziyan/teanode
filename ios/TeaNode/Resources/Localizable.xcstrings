    "Start another transcription pass?": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开始新一轮转录？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度文字起こししますか？"
          }
        }
      }
    },
    "A new pass can be billed again by the provider. Confirmed labels stay separate from generated versions. Rename a speaker without reprocessing to avoid another pass.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新一轮转录可能由提供商再次计费。已确认的标签独立于生成的版本。只重命名说话人无需重新处理，可避免再次转录。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新たな処理はプロバイダーから再度請求される場合があります。確認済みのラベルは生成されたバージョンと別に保持されます。話者名だけの変更なら再処理は不要です。"
          }
        }
      }
    },
    "Edit recording details": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑录音详情"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音の詳細を編集"
          }
        }
      }
    },
    "Meeting date is known": {
      "localizations": {
