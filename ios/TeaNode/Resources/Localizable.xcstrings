            "state": "translated",
            "value": "使用布局 %@"
          }
        }
      }
    },
    "In memory": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモリー内"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在记忆中"
          }
        }
      }
    },
    "In no group, so they can sign in and read nothing.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのグループにも属していないため、サインインできても何も読めません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
