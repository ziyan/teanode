            "state": "translated",
            "value": "来自对账单"
          }
        }
      }
    },
    "From your agent's memory": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの記憶から"
          }
        },
        "zh-Hans": {
          "stringUnit": {
