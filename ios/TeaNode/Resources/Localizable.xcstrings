          }
        }
      }
    },
    "Each person turns on their own agent, under Settings, Your agent. Once it is on, it can answer questions, sort your mail and act for you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントのオンは各自で、設定の「エージェント」から行います。オンにすると、質問への回答、メールの整理、代わりの作業ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个人各自开启自己的助手，在设置的“你的助手”里。开启后，它可以回答问题、整理邮件、替你办事。"
          }
        }
      }
    },
    "Circle made": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルを作成しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已创建圈子"
          }
        }
      }
    },
    "Open Circles": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルを開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开圈子"
          }
        }
      }
    },
    "Add to a circle": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルに追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到圈子"
          }
        }
      }
    },
    "%@ will not see new messages in this group. What was said stays.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はこのグループの新しいメッセージを見られなくなります。これまでの内容は残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将看不到这个群聊里的新消息，已发的消息会保留。"
          }
        }
      }
    },
    "Pages under it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページの下にあるページ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它下面的页面"
          }
        }
      }
    },
    "Nobody answered in time, so it expired.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に返事がなく、期限切れになりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有人及时回复，已过期。"
          }
        }
      }
    },
    "New circle": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルを作成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建圈子"
          }
        }
      }
    },
    "%@ is thinking": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が考え中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在思考"
          }
        }
      }
    },
    "Make member": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为普通成员"
          }
        }
      }
    },
    "Only %@'s owner can ask it in this chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をこのチャットで呼び出せるのは、持ち主だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有 %@ 的主人才能在此聊天中向它提问。"
          }
        }
      }
    },
    "%@ stopped sharing a calendar with you, so when everyone is free cannot be said.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がカレンダーの共有をやめたため、全員が空いている時間はわかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@已不再向你共享日历,所以无法判断大家何时有空。"
          }
        }
      }
    },
    "Chat options": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットのオプション"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "聊天选项"
          }
        }
      }
    },
    "Not shared with anybody yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰とも共有していません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有共享给任何人。"
          }
        }
      }
    },
    "Let someone in a circle you share run a skill of yours. It runs on your own computer, as you. Anything above the limits you set, or that cannot be priced, waits for your word.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じサークルの人に、あなたのスキルを実行させることができます。実行はあなたのコンピューターで、あなたとして行われます。設定した上限を超えるものや、金額が読み取れないものは、あなたの承認を待ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让同一圈子里的人运行你的技能。它在你自己的电脑上、以你的身份运行。超过你设定的上限，或无法确定金额的操作，会等待你的确认。"
          }
        }
      }
    },
    "Stopped sharing with %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との共有をやめました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止与%@共享"
          }
        }
      }
    },
    "Some people in your circles have not shared their calendar with you, so they are not listed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルの中に、カレンダーを共有していない人がいるため、一覧に出ていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "圈子里有些人没有把日历共享给你,所以没有列出。"
          }
        }
      }
    },
    "Share with": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有する相手"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享给"
          }
        }
      }
    },
    "Sharing was not stopped. Check your connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有を停止できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有停止共享。请检查网络连接后再试一次。"
          }
        }
      }
    },
    "Shown beside your name to the people you share a circle with. Without one, your initial is shown.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルを共有する人に、名前の横に表示されます。未設定の場合はイニシャルが表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会显示在你名字旁边，让与你同在一个圈子的人看到。未设置时显示你的首字母。"
          }
        }
      }
    },
    "No longer shared with %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@との共有をやめました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已不再与%@共享"
          }
        }
      }
    },
    "That did not work. Check your connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うまくいきませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作没有成功。请检查网络连接后再试一次。"
          }
        }
      }
    },
    "Add people": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーを追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加成员"
          }
        }
      }
    },
    "You are not in this chat any more. You can read it, but not write to it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットのメンバーではなくなりました。読むことはできますが、書き込めません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已不在这个聊天里，可以阅读，但不能再发消息。"
          }
        }
      }
    },
    "400.00": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "400.00"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "400.00"
          }
        }
      }
    },
    "Their agent is offered the tools you choose. Your computer must be connected for a tool to run, and you can stop sharing at any time.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだツールが相手のエージェントに提供されます。ツールの実行にはあなたのコンピューターが接続されている必要があり、共有はいつでもやめられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的助手会获得你选择的工具。工具运行时你的电脑必须在线，你也可以随时停止共享。"
          }
        }
      }
    },
    "No facts on this page are shared.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページで共有されている事実はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个页面没有共享任何事实。"
          }
        }
      }
    },
    "%@’s calendar": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@のカレンダー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的日历"
          }
        }
      }
    },
    "up to %@ a payment": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回あたり%@まで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单笔最多 %@"
          }
        }
      }
    },
    "%@’s agent asked to run %@ with your %@ skill": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんのエージェントが、あなたのスキル「%3$@」で%2$@を実行しようとしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@的助手想通过你的技能“%3$@”运行%2$@"
          }
        }
      }
    },
    "%@ and %@ are typing": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@が入力中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和 %2$@ 正在输入"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@"
          }
        }
      }
    },
    "No skill is installed to share.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有できるスキルがインストールされていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可共享的已安装技能。"
          }
        }
      }
    },
    "Tool": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "工具"
          }
        }
      }
    },
    "Message…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发消息…"
          }
        }
      }
    },
    "Message %@…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にメッセージ…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发消息给 %@…"
          }
        }
      }
    },
    "Shared with you in %@. You can read it but not change it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@で共有されています。閲覧のみで、変更はできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在%@中共享给你。你可以查看，但不能修改。"
          }
        }
      }
    },
    "This shares at least 1 page: this one and everything under it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページとその下のすべて、1ページ以上を共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将共享至少 1 个页面：这个页面以及它下面的所有页面。"
          }
        }
      }
    },
    "%@ loses %@ at once, and the record of what was asked through it goes with it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@さんは%2$@をすぐに使えなくなり、これまでの依頼の記録も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@会立刻失去%2$@，通过它发起过的请求记录也会一并删除。"
          }
        }
      }
    },
    "Calendars you hide here stay hidden on this phone only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで非表示にしたカレンダーは、このiPhoneでのみ非表示になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此隐藏的日历只会在这部手机上隐藏。"
          }
        }
      }
    },
    "Only its owner can ask that agent in this chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのエージェントをこのチャットで呼び出せるのは、持ち主だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有该助手的主人才能在此聊天中向它提问。"
          }
        }
      }
    },
    "Your chats are in the menu": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットはメニューにあります"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聊天在菜单里"
          }
        }
      }
    },
    "Latest hour": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一番遅い時刻"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最晚几点"
          }
        }
      }
    },
    "This tool does not say what it costs, so you are asked every time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このツールは費用を示さないため、毎回確認します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个工具没有说明费用，所以每次都会问你"
          }
        }
      }
    },
    "Picture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像"
          }
        }
      }
    },
    "%@ and %@ are thinking": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@と%2$@が考え中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 和 %2$@ 正在思考"
          }
        }
      }
    },
    "Enter the username of an account on this server. If nobody is listed, ask whoever runs this server to make their account.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーにあるアカウントのユーザー名を入力してください。誰も表示されない場合は、このサーバーを運用している人にアカウントの作成を頼んでください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入这台服务器上某个账号的用户名。如果没有列出任何人，请让运营这台服务器的人为他们创建账号。"
          }
        }
      }
    },
    "Last day": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最後の日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最后一天"
          }
        }
      }
    },
    "The owner's longer overview of this page is not shared.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち主によるこのページの長い概要は共有されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "主人对这个页面写的较长概述不会共享。"
          }
        }
      }
    },
    "You left %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から退出しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已退出 %@"
          }
        }
      }
    },
    "Swipe left, or touch and hold, to stop sharing.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有をやめるには、左にスワイプするか長押ししてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "向左滑动或长按可停止共享。"
          }
        }
      }
    },
    "1 person": {
      "localizations": {
