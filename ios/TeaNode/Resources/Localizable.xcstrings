          "stringUnit": {
            "state": "translated",
            "value": "利用可能 %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可用 %@"
          }
        }
      }
    },
    "%@ has to be a whole number": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は整数にしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 必须是整数"
          }
        }
      }
    },
    "%@ has to be at least %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$lld 以上にしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不能小于 %2$lld"
          }
        }
      }
    },
    "%@ has to be at most %lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$lld 以下にしてください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 不能大于 %2$lld"
          }
        }
      }
    },
    "%@ in, %@ out · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力 %1$@、出力 %2$@ · %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %1$@，输出 %2$@ · %3$@"
          }
        }
      }
    },
    "%@ is not in the form it asks for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の形式が違います"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的格式不对"
          }
        }
      }
    },
    "%@ is signed out of TeaNode and told nothing more. Connect it again to use it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は TeaNode からサインアウトされ、以後何も届きません。使うにはもう一度接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将退出 TeaNode，不再收到任何通知。要再次使用，请重新连接。"
          }
        }
      }
    },
    "%@ needs a value": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に値が必要です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 需要一个值"
          }
        }
      }
    },
    "%@ now goes %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ は %2$@ になりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 现在%2$@"
