            "state": "translated",
            "value": "只读"
          }
        }
      }
    },
    "Before it is shared, you see exactly what they will be shown.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有する前に、相手に表示される内容をそのまま確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
