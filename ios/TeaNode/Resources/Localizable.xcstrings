    "Import address changed. The old one no longer takes mail.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込みアドレスを変更しました。古いアドレスではもうメールを受け付けません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入地址已更换，旧地址不再接收邮件。"
          }
        }
      }
    },
    "Import as statements": {
      "localizations": {
