      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已同意"
          }
        }
      }
