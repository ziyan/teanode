    "Important": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "重要"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重要"
          }
        }
      }
    },
    "Imported %lld contacts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先を %lld 件読み込みました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入 %lld 位联系人。"
          }
        }
      }
    },
    "Imported 1 contact.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先を 1 件読み込みました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入 1 位联系人。"
          }
        }
      }
    },
    "Imported into %@: %lld added, %lld updated, %lld already here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に取り込みました：追加 %2$lld 件、更新 %3$lld 件、既存 %4$lld 件。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入到 %1$@：新增 %2$lld 笔，更新 %3$lld 笔，%4$lld 笔已存在。"
          }
        }
      }
    },
    "Imported into %@: %lld added, %lld updated, %lld already here. Not imported: %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ に取り込みました：追加 %2$lld 件、更新 %3$lld 件、既存 %4$lld 件。取り込めなかったもの：%5$@。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已导入到 %1$@：新增 %2$lld 笔，更新 %3$lld 笔，%4$lld 笔已存在。未导入：%5$@。"
          }
        }
      }
    },
    "Importing %lld of %lld…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld 件を読み込み中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在导入 %lld / %lld…"
          }
        }
      }
    },
    "Importing is off. Turn the Imported statements source on to import again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り込みはオフです。取り込んだ明細のソースをオンにすると、また取り込めます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入已关闭。打开“已导入的对账单”来源即可重新导入。"
          }
        }
      }
    },
    "In": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入"
          }
        }
      }
    },
    "In Telegram, open @BotFather, send /newbot, and paste the token it gives you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Telegram で @BotFather を開き、/newbot を送って、渡されたトークンを貼り付けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
