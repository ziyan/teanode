    "Every browser signed in to this account is signed out and has to sign in again. This iPhone stays connected.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアカウントにサインインしているすべてのブラウザーがサインアウトされ、もう一度サインインが必要になります。この iPhone は接続したままです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此账号下已登录的所有浏览器都会被登出，需要重新登录。这部 iPhone 保持连接。"
