          }
        }
      }
    },
    "5 days": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "5日間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
