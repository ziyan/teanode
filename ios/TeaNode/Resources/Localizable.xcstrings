    },
    "Hide from People": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人物」で非表示にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“人物”中隐藏"
          }
        }
      }
    },
    "Photos you move to the Trash stay here for %lld days.": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Photos you move to the Trash stay here for %lld day."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Photos you move to the Trash stay here for %lld days."
                }
              }
            }
          }
        },
        "ja": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ゴミ箱に入れた写真は %lld 日間ここに残ります。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "ゴミ箱に入れた写真は %lld 日間ここに残ります。"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "移到废纸篓的照片会在此保留 %lld 天。"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "移到废纸篓的照片会在此保留 %lld 天。"
                }
              }
            }
          }
        }
      }
    },
    "There is nobody else to merge with yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "統合できるほかの人物はまだいません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有可以合并的其他人物。"
          }
        }
      }
    },
    "The photos stay in their owners' libraries.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はそれぞれの持ち主のライブラリに残ります。"
