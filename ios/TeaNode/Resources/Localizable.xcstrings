    "Input": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入"
          }
        }
      }
    },
    "Install": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装"
          }
        }
      }
    },
    "Installed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装"
          }
        }
      }
    },
    "Installed %@ %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ をインストールしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已安装 %@ %@"
          }
        }
      }
    },
    "Instance": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスタンス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实例"
          }
        }
      }
    },
    "Integrations": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連携"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "集成"
          }
        }
      }
    },
    "Internal": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内部"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内部"
          }
        }
      }
    },
    "Into the conversation": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "送到对话里"
          }
        }
      }
    },
    "Into the mailbox of %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のメールボックスへ: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投递到邮箱：%@"
          }
        }
      }
    },
    "Invented": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作り話"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编造"
          }
        }
      }
    },
    "Investments": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投資"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投资"
          }
        }
      }
    },
    "Investments: holdings and trades in brokerage and retirement accounts": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "投資：証券口座や退職口座の保有銘柄と売買"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "投资：证券账户和退休账户的持仓与买卖记录"
          }
        }
      }
    },
    "Invitations go out by mail when the event is saved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定を保存すると招待がメールで送られます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存日程时会通过邮件发送邀请。"
          }
        }
      }
    },
    "Invited": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待者"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "受邀者"
          }
        }
      }
    },
    "Issuer URL": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "発行者 URL"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签发者 URL"
          }
        }
      }
    },
    "It came back.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復帰しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复。"
          }
        }
      }
    },
    "It can no longer read this.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読めなくなりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它不能再读取了。"
          }
        }
      }
    },
    "It can read this now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを読めるようになりました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在它可以读取了。"
          }
        }
      }
    },
    "It did not say why.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "理由は示されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有说明原因。"
          }
        }
      }
    },
    "It finished without saying anything.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も返さずに終了しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它结束了，但没有返回任何内容。"
          }
        }
      }
    },
    "It goes to your main conversation.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メインの会話に届きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会发到你的主对话里。"
          }
        }
      }
    },
    "It has decided against nothing here yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここではまだ何も見送っていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在这里还没有否决过任何文件。"
          }
        }
      }
    },
    "It has not answered since it was asked to restart. Something has to start it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再起動を要求してから応答がありません。何かが起動し直す必要があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求重启后它一直没有响应。需要有程序把它重新启动起来。"
          }
        }
      }
    },
    "It has to be an SVG of the restricted kind BIMI accepts: no script, no animation, nothing fetched from elsewhere, and square. This checks that before publishing it, and says what is wrong if anything is.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルは BIMI が認める制限付きの SVG である必要があります。スクリプトなし、アニメーションなし、外部参照なし、正方形。公開前に確認し、問題があれば内容を示します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件必须是 BIMI 允许的受限 SVG：不含脚本、不含动画、不引用外部资源，且为正方形。发布前会先检查，并指出具体问题。"
          }
        }
      }
    },
    "It is back among the open ideas.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いているアイデアに戻しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已放回待选的想法中。"
          }
        }
      }
    },
    "It is in Schedules below, as \"Daily brief\".": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下のスケジュールに「Daily brief」としてあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它在下面的日程中，名为“Daily brief”。"
          }
        }
      }
    },
    "It is removed from your address book and from every device that reads it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス帳と、それを読むすべてのデバイスから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你的通讯录以及所有读取通讯录的设备中移除。"
          }
        }
      }
    },
    "It is removed from your calendar.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーから削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你的日历中移除。"
          }
        }
      }
    },
    "It is shown this once. Type it into the mail program now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示は一度だけです。今メールアプリに入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它只会显示这一次，请现在输入到邮件程序中。"
          }
        }
      }
    },
    "It is turned off for this server. Turn it on in Services.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーではオフになっています。「サービス」でオンにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器已关闭此功能。可在“服务”中开启。"
          }
        }
      }
    },
    "It is turned off for this server. Whoever manages your TeaNode server can turn it on.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーではオフになっています。TeaNode サーバーの管理者がオンにできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器已关闭此功能。管理你的 TeaNode 服务器的人可以将其开启。"
          }
        }
      }
    },
    "It reads this at its next turn.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のターンで読みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会在下一次运行时读到。"
          }
        }
      }
    },
    "It takes no more turns. You can reopen it later.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これ以上ターンを取りません。後で再開できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将不再运行。你之后可以重新开启。"
          }
        }
      }
    },
    "Its %lld messages are deleted with it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "中の %lld 件のメッセージも削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中的 %lld 封邮件也会被删除。"
          }
        }
      }
    },
    "Its %lld values go with it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件の評価額も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的 %lld 条估值也会一并删除。"
          }
        }
      }
    },
    "Its accounts and transactions are deleted from TeaNode. For SimpleFIN, also revoke the access on its site.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その口座と取引は TeaNode から削除されます。SimpleFIN の場合はそのサイトでもアクセスを取り消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其账户和交易会从 TeaNode 删除。对于 SimpleFIN，也请在其网站撤销访问权限。"
          }
        }
      }
    },
    "Its members keep their accounts and lose what the group gave them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーのアカウントは残り、グループが与えていた権限だけを失います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员保留账号，但失去群组赋予的权限。"
          }
        }
      }
    },
    "Its picture and lines are deleted too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画像と明細も削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其图片和明细也会被删除。"
          }
        }
      }
    },
    "Its tools stop being offered to everybody here. It can be installed again from the registry.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここの全員にツールが提供されなくなります。あとでレジストリから入れ直せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的工具将不再提供给此处的任何人。之后可以从注册表重新安装。"
          }
        }
      }
    },
    "Its transactions become uncategorized, and its budget and rules are deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その取引は未分類になり、予算とルールは削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其交易会变为未分类，预算和规则也会被删除。"
          }
        }
      }
    },
    "Jobs given up on": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "諦めたジョブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已放弃的任务"
          }
        }
      }
    },
    "Judgment across pages: overviews, reflections, a survey’s pages": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページをまたぐ判断：概要、振り返り、調査の各ページ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跨页面的判断：概述、反思、调查的各个页面"
          }
        }
      }
    },
    "Jump to the end": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "末尾へ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "跳到末尾"
          }
        }
      }
    },
    "Junk": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "迷惑メール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "垃圾邮件"
          }
        }
      }
    },
    "Keep a calendar, and sync it to a device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カレンダーを持ち、端末と同期する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存日历，并同步到设备"
          }
        }
      }
    },
    "Keep an address book, and sync it to a device": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレス帳を持ち、端末と同期する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存通讯录，并同步到设备"
          }
        }
      }
    },
    "Keep as it is (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このまま（%@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持不变（%@）"
          }
        }
      }
    },
    "Keep corrections for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "修正の保持期間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更正记录保留"
          }
        }
      }
    },
    "Keep it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保持する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留"
          }
        }
      }
    },
    "Keep retrying for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行を続ける期間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重试保留时长"
          }
        }
      }
    },
    "Keep run transcripts for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行記録の保持期間"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行记录保留"
          }
        }
      }
    },
    "Kept %@ for %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ の %1$@ を保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %2$@ 保存 %1$@"
          }
        }
      }
    },
    "Kept as stored; type to replace": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのものを保持。置き換えるには入力"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留已存的；输入以替换"
          }
        }
      }
    },
    "Kept on this server for every person's agent. A value is written and never shown again; type a new one to change it, leave it blank to keep it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーに保存され、全員のエージェントが使います。書き込まれると二度と表示されません。変えるには新しい値を入力し、空のままなら保持されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在此服务器上，供每个人的助手使用。写入后不再显示；输入新值即可更改，留空则保留。"
          }
        }
      }
    },
    "Kept out of the Inbox": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信トレイに入れないようにしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不再进入收件箱"
          }
        }
      }
    },
    "Kept sealed on the server and sent only to the computer that reads this source; it is never shown again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに封をして保存され、このソースを読むコンピューターにだけ送られます。二度と表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
