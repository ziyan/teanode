        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这些日期和时段里,没有大家都有空的时间。"
          }
        }
      }
    },
    "They sign in with that username and password, and can change the password themselves in their settings.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その人はこのユーザー名とパスワードでサインインし、パスワードは自分の設定で変更できます。"
