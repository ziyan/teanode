    "Mail already sent and signed with the old key stops verifying as soon as you change the DNS record, so do this only when rotating.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DNS レコードを変更した時点で、古い鍵で署名して送信済みのメールは検証できなくなります。鍵をローテーションするときだけ実行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一旦修改 DNS 记录，此前用旧密钥签名并已发出的邮件将无法通过验证，因此仅在轮换密钥时才这样做。"
          }
        }
      }
    },
    "Mail and calendars": {
      "localizations": {
