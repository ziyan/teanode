    "Everyone in %@ could see your calendar, as much as you choose. An event you mark private is only ever shown as busy.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の全員が、あなたが選んだ範囲であなたのカレンダーを見られるようになります。非公開にした予定は、常に「予定あり」としてだけ表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@里的所有人可以在你选择的范围内看到你的日历。你标为私密的日程只会显示为“忙碌”。"
          }
        }
      }
