        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$lld 个日程"
          }
        }
      }
    },
    "%@: \"%@\" is not in the form it asks for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@：「%2$@」の形式が違います"
          }
        },
