          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无标题"
          }
        }
      }
    },
    "Usage today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の使用量"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日用量"
          }
        }
      }
    },
    "Used %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を使用"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用了 %@"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バージョン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "Waiting for the turn before it…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前のターンを待っています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待上一轮完成…"
          }
        }
      }
    },
    "What to show": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する内容"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示内容"
          }
        }
      }
    },
    "What your agent did on its own, as it happened. Ask about it here, or go back to the main chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分で行ったことを、起きた順に記録しています。ここで尋ねるか、メインのチャットに戻れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手自行完成的事，按发生顺序记录。可以在这里问它，或回到主对话。"
          }
        }
      }
    },
    "What your agent says on its own": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分から伝えること"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理主动说的话"
          }
        }
      }
    },
    "Working on it…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対応しています…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理…"
          }
        }
