    "%@ stops being able to sign in. Your password still works, so this does not lock you out.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ではサインインできなくなります。パスワードは引き続き使えるので締め出されることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将无法再用于登录。你的密码仍然有效，因此不会被锁在外面。"
          }
        }
      }
    },
    "%@ stops working at once, and has to be authorized again to come back.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ はすぐに動かなくなり、戻すには再度許可が必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 会立即停止工作，需要重新授权才能恢复。"
          }
        }
      }
    },
    "%@ to %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 〜 %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 至 %2$@"
          }
        }
      }
    },
    "%@ to today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@から今日まで"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@至今天"
