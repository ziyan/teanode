    "This is %@'s agent. What you say here reaches it as %@, and the server log says you did.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは %@ のエージェントです。ここで話しかけると %@ として届き、サーバーのログにそのことが残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 %@ 的助手。你在这里说的话会以 %@ 的身份到达它，服务器日志会记录这一点。"
          }
        }
      }
    },
    "This is me": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは自分"
          }
        },
        "zh-Hans": {
