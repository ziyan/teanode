    "Pay, buy, sell, trade, or place or cancel an order, a transfer or a payment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い、購入、売却、取引、注文・送金・支払いの発注や取り消し。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款、购买、出售、交易，或下达、取消订单、转账或付款。"
          }
        }
      }
    },
    "Payer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払者"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款方"
          }
        }
      }
    },
    "Per million tokens. An arrow is a price set from the bill; a price within five percent of the bill's is left as it is. A price from a pattern is shown and never changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "100 万トークンあたり。矢印は請求額から設定した価格です。請求額との差が 5% 以内の価格はそのままにします。パターンの価格は表示するだけで、変更しません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每百万 token。箭头表示按账单设置的价格；与账单相差不超过 5% 的价格保持不变。来自模式条目的价格只显示，不会更改。"
          }
        }
      }
    },
    "Prices checked against the bill %@: %@ changed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を請求額と照合しました(%1$@):%2$@ 件を変更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将价格与账单核对（%1$@）：更改了 %2$@ 项"
          }
        }
      }
    },
    "Prices checked against the bill: %@ changed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を請求額と照合しました:%@ 件を変更"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将价格与账单核对：更改了 %@ 项"
          }
        }
      }
    },
    "Prices checked against the bill: they match": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "価格を請求額と照合しました:一致しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已将价格与账单核对：完全一致"
          }
        }
      }
    },
    "Prices from the bill": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "請求額から見た価格"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账单中的价格"
          }
        }
      }
    },
    "Show a month or a year": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月ごとか年ごとかを選ぶ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按月或按年显示"
          }
        }
      }
    },
    "Spending in the chosen month, day by day, against where the month before stood on the same day. Transfers are left out; amounts are in your reporting currency.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだ月の支出を日ごとに、前の月の同じ日までの支出と比べます。振替は除き、金額は集計通貨です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所选月份每天的支出，对比上个月同一天的累计。不含转账，金额以汇总货币计。"
          }
        }
      }
    },
    "Stalled": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停滞"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停滞"
          }
        }
      }
    },
    "Stop telling me about follow-ups": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォローについては伝えない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要再告诉我跟进的事"
          }
        }
      }
    },
    "Stopped following: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
