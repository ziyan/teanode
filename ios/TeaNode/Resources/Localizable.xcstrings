          "stringUnit": {
            "state": "translated",
            "value": "表示する内容"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示内容"
          }
        }
      }
    },
    "What your agent did on its own, as it happened. Ask about it here, or go back to the main chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分で行ったことを、起きた順に記録しています。ここで尋ねるか、メインのチャットに戻れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手自行完成的事，按发生顺序记录。可以在这里问它，或回到主对话。"
          }
        }
      }
    },
    "What your agent says on its own": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分から伝えること"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理主动说的话"
          }
        }
