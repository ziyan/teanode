            "value": "变更内容"
          }
        }
      }
    },
    "What changed in %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の変更点"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的变更内容"
          }
        }
      }
    },
    "What do you want to know?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を知りたいですか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你想知道什么？"
          }
        }
      }
    },
    "What done looks like, and anything it should know": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完了の条件と、知っておくべきこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "怎样算完成，以及它应知道的事"
          }
        }
      }
    },
    "What is arriving, and what is stuck.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "届いているもの、滞っているもの。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在到达的邮件，以及卡住的邮件。"
          }
        }
      }
    },
    "What is known": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "分かっていること"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已知内容"
          }
        }
      }
    },
    "What is left each month": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎月の残り"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月结余"
          }
        }
      }
    },
    "What it arrives for, and how each domain is set up.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰宛てに届くのか、各ドメインの設定。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件为谁而来，以及每个域名的设置。"
          }
        }
      }
    },
    "What it did": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "したこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做了什么"
          }
        }
      }
    },
    "What it dreams": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢の整理"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的梦境整理"
          }
        }
      }
    },
    "What it is": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "種類"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是什么"
          }
        }
      }
    },
    "What it is for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用途"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用途"
          }
        }
      }
    },
    "What it learned from you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたから学んだこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你这里学到的"
          }
        }
      }
    },
    "What it looks for": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "対象の文字列"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "匹配内容"
          }
        }
      }
    },
    "What it may reach": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "触れてよいもの"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它可以访问什么"
          }
        }
      }
    },
    "What it says about itself": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明を読む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的说明"
          }
        }
      }
    },
    "What people may turn on": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用者が有効にできる機能"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户可以开启的功能"
          }
        }
      }
    },
    "What should I ask?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を聞きますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要问什么？"
          }
        }
      }
    },
    "What should the reply say? (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信の内容は？（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复应该说什么？（可选）"
          }
        }
      }
    },
    "What sort of place": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのような場所か"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "属于哪种地方"
          }
        }
      }
    },
    "What the agent may reach for, by family and by tool. Off is never offered; ask first raises a tool to a confirmation card every time; a tool marked as always asking does so by its risk whatever is set here. A family's word covers its tools unless one says otherwise.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが使えるツールを、ファミリーごと・ツールごとに。オフは提供しない、先に確認は毎回確認カードを出す。常に確認と印のあるツールはここでの設定によらずリスクゆえに確認します。ファミリーの方針は、個別に指定しない限りそのツールに及びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手可使用的工具，按类别和单个工具设置。关闭表示永不提供；先询问表示每次都弹出确认卡；标为总是询问的工具按其风险始终询问。类别的策略覆盖其中的工具，除非工具单独设置。"
          }
        }
      }
    },
    "What the authenticator shows the person deciding whether to allow it. Your server’s name, in words rather than as a host.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可するかを判断する人に認証器が見せる名前です。ホスト名ではなく、言葉としてのサーバー名を。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "验证器向正在决定是否允许的人展示的名称。用文字写出你的服务器名，而不是主机名。"
          }
        }
      }
    },
    "What the day holds and what is waiting for you, sent to you as mail. It is an ordinary schedule called \"Daily brief\"; change what it asks for in Schedules below.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定と待っていることを、メールで送ります。実体は「Daily brief」という通常のスケジュールで、内容は下のスケジュールで変えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有什么安排、有什么在等你，以邮件发送。它其实是一条名为“Daily brief”的普通日程；在下面的日程中可以修改内容。"
          }
        }
      }
    },
    "What the day holds and what is waiting for you, sent to you as mail. It is the schedule called “Daily brief” below, where you can change what it asks for.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定と待っていることを、メールで送ります。下の「Daily brief」というスケジュールがそれで、そこで内容を変えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有什么安排、有什么在等你，以邮件发送。它就是下面名为“Daily brief”的日程，可以在那里修改它要做的事。"
          }
        }
      }
    },
    "What the day holds and what is waiting for you, sent to you as mail. Turning it on adds an ordinary schedule called “Daily brief” below, where you can change what it asks for.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の予定と待っていることを、メールで送ります。オンにすると、下に「Daily brief」という通常のスケジュールが追加され、そこで内容を変えられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有什么安排、有什么在等你，以邮件发送。开启后会在下面添加一条名为“Daily brief”的普通日程，可以在那里修改它要做的事。"
          }
        }
      }
    },
    "What the registry offers": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レジストリにあるスキル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册表提供的技能"
          }
        }
      }
    },
    "What the rules would do": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ルールの結果"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "规则会做什么"
          }
        }
      }
    },
    "What the year's 1099s report: interest, dividends and the gains or losses on sales.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その年の 1099 が報告するもの：利子、配当、売却の損益。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一年的 1099 报告的内容：利息、股息和出售的盈亏。"
          }
        }
      }
    },
    "What they did": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受信側の処理"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理方式"
          }
        }
      }
    },
    "What they did with it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告者の処理"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方的处理"
          }
        }
      }
    },
    "What this server accepts from whoever connects to it. Every one of these is read for each message or each connection, so a change applies to the next one.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーが接続してきた相手から受け入れる範囲です。以下はいずれもメールごと、接続ごとに読まれるため、変更は次の一通から効きます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本服务器对连接进来的一方所接受的范围。以下每一项都会在每封邮件或每次连接时读取，因此修改会在下一次生效。"
          }
        }
      }
    },
    "What this server calls itself, and how much it writes down.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーが自分をどう名乗り、どれだけ記録するかです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本服务器如何称呼自己，以及记录多少日志。"
          }
        }
      }
    },
    "What to call it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "呼び名"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "称呼"
          }
        }
      }
    },
    "What to do, as you would say it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何をするか、話しかけるように"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做什么，像平时说话一样"
          }
        }
      }
    },
    "What to estimate from": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見積もりの根拠"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "估算依据"
          }
        }
      }
    },
    "What to show": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "表示する内容"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "显示内容"
          }
        }
      }
    },
    "What to tell a mail client": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールクライアントに伝える宛先"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉邮件客户端的地址"
          }
        }
      }
    },
    "What to type into a mail program to read this server’s mailboxes: plain, turning to TLS before signing in. It follows the server unless something in front forwards a different port.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーのメールボックスを読むためにメールソフトに入力する接続先です。平文で接続し、サインイン前に TLS に切り替えます。前段で別のポートに転送していない限り、サーバー自身の設定に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在邮件程序中填写的地址，用于读取本服务器的邮箱：先明文连接，登录前切换到 TLS。除非前面有转发不同端口的设备，否则跟随服务器本身。"
          }
        }
      }
    },
    "What to type into a mail program to read this server’s mailboxes: with TLS from the first byte. It follows the server unless something in front forwards a different port.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーのメールボックスを読むためにメールソフトに入力する接続先です。最初から TLS で接続します。前段で別のポートに転送していない限り、サーバー自身の設定に従います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在邮件程序中填写的地址，用于读取本服务器的邮箱：从第一个字节起就使用 TLS。除非前面有转发不同端口的设备，否则跟随服务器本身。"
          }
        }
      }
    },
    "What to work toward": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目指すこと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要达成什么"
          }
        }
      }
    },
    "What used to be true": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の答え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以前的答案"
          }
        }
      }
    },
    "What was written is gone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書いた内容は失われます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已写的内容会丢失。"
          }
        }
      }
    },
    "What will hold it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "用途のメモ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用途备注"
          }
        }
      }
    },
    "What you asked not to be told about. Unmute one to hear about it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "伝えないよう頼んだもの。ミュートを解除すると、また伝えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你要求不再告诉你的事。取消静音后会再次告诉你。"
          }
        }
      }
    },
    "What you sign in with. Changing it takes your sessions and API tokens with it, so nothing has to be signed in again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインに使う名前です。変更してもセッションと API トークンはそのまま引き継がれ、再サインインは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于登录的名字。修改后会话和 API 令牌会一并迁移，无需重新登录。"
          }
        }
      }
    },
    "What your agent answered on your behalf, what it is about to, and what it left alone and why.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがあなたの代わりに返信したもの、これから返信するもの、返信しなかったものとその理由。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手替你回复了什么、即将回复什么、没有回复什么以及原因。"
          }
        }
      }
    },
    "What your agent answered to each question, from each source, and what the grader made of it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各質問に対して、エージェントがそれぞれのソースから何と答え、採点者がどう判定したか。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手从每个来源对每个问题的回答，以及评分者的判定。"
          }
        }
      }
    },
    "What your agent did on its own, as it happened. Ask about it here, or go back to the main chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分で行ったことを、起きた順に記録しています。ここで尋ねるか、メインのチャットに戻れます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手自行完成的事，按发生顺序记录。可以在这里问它，或回到主对话。"
          }
        }
      }
    },
    "What your agent filed after your recent conversations, newest first. Strike anything it should not have kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近の会話のあとにエージェントが整理したもの。新しい順です。残すべきでないものは取り消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手在你最近的对话之后归档的内容，最新在前。不该记的可以划掉。"
          }
        }
      }
    },
    "What your agent left running on your computers, from every chat. A command still running after 24 hours is stopped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントがあなたのコンピューターでバックグラウンドに残したコマンド（すべてのチャット分）。24 時間を超えて実行中のものは停止されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手在你的电脑上留在后台运行的命令，来自所有对话。运行超过 24 小时的命令会被停止。"
          }
        }
      }
    },
    "What your agent marks as high priority appears here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが優先度高とした内容がここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手标为高优先级的邮件会显示在这里。"
          }
        }
      }
    },
    "What your agent may do without asking, in a schedule, a goal or overnight, when there is nobody to confirm. Anything not ticked is refused then, and your agent tells you what it would have done. Mail sorting and replies drafted from incoming mail only ever read, whatever is ticked.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スケジュール、目標、夜間の処理など、確認できる人がいないときに、尋ねずに行ってよいこと。チェックしていないものはその場合は行わず、何をするつもりだったかを伝えます。届いたメールの分類や返信の下書きは、設定にかかわらず読むだけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在计划任务、目标或夜间运行中，没有人可以确认时，你的助手可以不经询问去做的事。未勾选的事那时会被拒绝，助手会告诉你它本来要做什么。整理来信和根据来信起草回复，无论如何设置都只读。"
          }
        }
      }
    },
    "What your agent says on its own": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが自分から伝えること"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助理主动说的话"
          }
        }
      }
    },
    "What your agent told you unasked, newest first, with the messages each was about. Mute one to stop hearing about things like it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントが頼まれずに伝えたこと。新しい順で、それぞれ元になったメール付きです。ミュートすると、同じようなことは伝えなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理不等你问就告诉你的事，最新的在前，附上每条涉及的邮件。静音一条，就不再听到类似的事。"
          }
        }
      }
    },
    "When": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日時"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "时间"
          }
        }
      }
    },
    "When %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当 %@"
          }
        }
      }
    },
    "When all of these match": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてに一致したとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当以下条件全部满足"
          }
        }
      }
    },
    "When and how to answer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ、どう返信するか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "何时以及如何回复"
          }
        }
      }
    },
    "When it may dream": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夢を見る時間帯"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它何时可以做梦"
          }
        }
      }
    },
    "When it was true (2023-06)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつのことか（2023-06）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "何时成立（2023-06）"
          }
        }
      }
    },
    "When set, signing in through the identity provider adds and removes people here to match that group.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定すると、ID プロバイダーでのサインイン時にそのグループに合わせてメンバーが追加・削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置后，通过身份提供方登录时会按该群组增减此处的成员。"
          }
        }
      }
    },
    "When you are not there": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不在のとき"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你不在时"
          }
        }
      }
    },
    "When, as a cron line": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつ（cron 形式）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "何时（cron 格式）"
          }
        }
      }
    },
    "Where a copy of every stored message goes. Needed only when more than one instance shares this database, because it is how any of them can read a message another one received.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された各メッセージの複製を置く場所です。複数のインスタンスがこのデータベースを共有する場合にのみ必要で、どのインスタンスからでも他が受け取ったメッセージを読めるようにするためのものです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每封已存邮件副本的存放位置。仅当多个实例共用此数据库时才需要，因为这是它们互相读取对方收到的邮件的方式。"
          }
        }
      }
    },
    "Where it went": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使い道"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱花在哪了"
          }
        }
      }
    },
    "Where mail and state are written. Shown and not editable here: a server restarted against a different directory does not find what is in the old one, and the mail simply is not there any more. Moving it is done with the server stopped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールと状態を書く場所です。ここでは表示のみで変更できません。別のディレクトリで再起動したサーバーは元の中身を見つけられず、メールは無いのと同じになります。移動はサーバーを止めて行います。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件和状态写在哪里。这里只显示、不可修改：服务器改用另一个目录重启后，找不到原目录里的东西，那些邮件就等于不存在了。迁移要在服务器停止的状态下进行。"
          }
        }
      }
    },
    "Where mail from other servers arrives, normally :25. Changing this without changing what forwards to it stops mail arriving at all.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のサーバーからのメールが届く場所で、通常は :25。転送元を直さずにここだけ変えると、メールがまったく届かなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他服务器投递来的邮件从哪里进来，通常是 :25。改了它却没有同时改转发到它的东西，邮件就完全收不到了。"
          }
        }
      }
    },
    "Where mail programs read mailboxes, encrypted from the first byte: port 993. Empty turns it off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールソフトがメールボックスを読む口。最初から暗号化されます。ポート 993。空にすると無効です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件客户端读取邮箱的入口，从第一个字节起加密：端口 993。留空则关闭。"
          }
        }
      }
    },
    "Where messages are written, and how long a delivery that keeps failing is kept.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールをどこに書くか、そして失敗し続ける配送をどれだけ保つかです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邮件写在哪里，以及一直投递失败的邮件保留多久。"
          }
        }
      }
    },
    "Where on it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その中のどこ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在哪个位置"
          }
        }
      }
    },
    "Where senders connect from": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送信元の所在"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发件方来自何处"
          }
        }
      }
    },
    "Where the answer goes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "答えの届け先"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "答复送到哪里"
          }
        }
      }
    },
    "Where the certificate authority writes if something is wrong or a certificate is about to expire without having renewed. Not published anywhere.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不具合があったとき、あるいは更新されないまま証明書が切れそうなときに認証局が書き送る先です。どこにも公開されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出问题时，或证书即将过期却未能续期时，证书颁发机构会写信到这里。不会公开在任何地方。"
          }
        }
      }
    },
    "Where the command runs": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドを実行する場所"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令在哪里运行"
          }
        }
      }
    },
    "Where the domain permissions of these roles apply. Permissions over every domain do not need a list.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらのロールのドメイン権限が及ぶ範囲。すべてのドメインに及ぶ権限には一覧は不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些角色的域名权限作用的范围。作用于全部域名的权限不需要列表。"
          }
        }
      }
    },
    "Where the gains come from": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "譲渡益の出所"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "利得的来源"
          }
        }
      }
    },
    "Where these are": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "場所"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所在位置"
          }
        }
      }
    },
    "Where this dashboard is served, normally :443. This is the address the dashboard is reached at.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このダッシュボードを配信する場所。通常は :443 です。ダッシュボードにアクセスするアドレスです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仪表板的服务地址，通常是 :443。这是访问仪表板所用的地址。"
          }
        }
      }
    },
    "Where this server writes to you, such as when a domain’s DNS records stop resolving. Optional.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドメインの DNS レコードが解決しなくなったときなど、このサーバーからの連絡先です。省略可。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本服务器与你联系的地址，例如某个域的 DNS 记录不再解析时。可选。"
          }
        }
      }
    },
    "Where what it finds is filed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見つけたものを置く場所"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它读到的内容归档到哪里"
          }
        }
      }
    },
    "Where your own devices hand this server mail to send, normally :587. A mail client configured against the old port stops being able to send.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の端末が送信するメールをこのサーバーに渡す場所で、通常は :587。古いポートで設定されたメールソフトは送信できなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你自己的设备把待发邮件交给本服务器的地方，通常是 :587。按旧端口配置的邮件客户端将无法再发信。"
          }
        }
      }
    },
    "Which computer": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのコンピューター"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪台电脑"
          }
        }
      }
    },
    "Which computer each skill and connected server makes its requests through. A service that answers only inside one network, such as one behind a company VPN, needs a computer on that network.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各スキルと接続サーバーのリクエストを、どのコンピューター経由で送るか。会社の VPN の内側など、特定のネットワーク内でしか応答しないサービスには、そのネットワーク上のコンピューターが必要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个技能和已连接服务器的请求经由哪台电脑发出。只在某个网络内响应的服务（例如公司 VPN 之后的服务）需要该网络上的电脑。"
          }
        }
      }
    },
    "Which day suits you for the dentist?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歯医者はどの日がいいですか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪天去看牙医合适？"
          }
        }
      }
    },
    "Which groups somebody is in is set on the group, where the roles and domains it carries are.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰がどのグループに属するかはグループで設定します。グループが持つロールとドメインも同じ場所です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户属于哪些群组在群组中设置，群组的角色和域名也在那里。"
          }
        }
      }
    },
    "Which mailbox": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どのメールボックス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪个邮箱"
          }
        }
      }
    },
    "Which model does which work. Default is anything not named; fast is used for sorting, summaries and compaction unless overridden; embedding enables search by meaning.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの作業にどのモデルを使うか。既定は指定のないすべて。高速は上書きがなければ仕分け・要約・圧縮に使われます。埋め込みは意味検索を有効にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各项工作使用的模型。默认用于未指定的一切；快速模型在未覆盖时用于分拣、摘要和压缩；嵌入模型启用语义搜索。"
          }
        }
      }
    },
    "Which model does which work. Default is anything not named; fast is used for sorting, summaries and compaction unless overridden; quick answers what you type first and hands anything that needs reasoning to the conversations model; embedding enables search by meaning.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの作業にどのモデルを使うか。既定は指定のないすべて。高速は上書きがなければ仕分け・要約・圧縮に使われます。クイックは入力されたメッセージにまず答え、推論が必要なものは会話用モデルに渡します。埋め込みは意味検索を有効にします。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各项工作使用的模型。默认用于未指定的一切；快速模型在未覆盖时用于分拣、摘要和压缩；快捷模型先回答您输入的消息，需要推理的交给对话模型；嵌入模型启用语义搜索。"
          }
        }
      }
    },
    "Which runs read it": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "どの実行が読むか"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "哪些任务会读取"
          }
        }
      }
    },
    "Which services people may link their banks, cards, brokerages and loans through. Each person links their own; nothing is linked from here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用者が銀行、カード、証券口座、ローンを連携するときに使えるサービス。連携は各自が行い、ここからは何も連携されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户可以通过哪些服务关联自己的银行、信用卡、证券账户和贷款。每个人自己关联，这里不会关联任何账户。"
          }
        }
      }
    },
    "While you are asleep your agent works through what arrived, writes up the month, and tidies what it knows. It never forgets anything on its own.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが眠っているあいだに、届いたものを読み、その月をまとめ、知っていることを整理します。自分から何かを忘れることはありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你睡着时，助手会处理新到的内容、写这个月的记录，并整理它所知道的。它绝不会自行删除任何东西。"
          }
        }
      }
    },
    "While you are idle, your agent now and then offers one of its ideas: something it could do for you. The whole list is under Ideas.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作していない間に、エージェントがときどき、あなたのためにできることを一つ提案します。一覧は「アイデア」にあります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你空闲时，你的助手会不时提出一个它能为你做的事。完整列表在“想法”中。"
          }
        }
      }
    },
    "Who": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰が"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "谁"
          }
        }
      }
    },
    "Who fills its values in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "値を入力するのは誰か"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由谁填写它的值"
          }
        }
      }
    },
    "Who is in %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ のメンバー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的成员"
          }
        }
      }
    },
    "Who reported this": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "報告元"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "报告方"
          }
        }
      }
    },
    "Who you are, how you write, what matters to you. \"I am the treasurer of the sailing club; anything from the club is important; sign as Z.\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが誰で、どう書き、何が大事か。「私はヨットクラブの会計です。クラブからのものは重要。Z と署名する。」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你是谁、如何写作、什么重要。\"我是帆船俱乐部的司库；来自俱乐部的邮件都重要；署名 Z。\""
          }
        }
      }
    },
    "Whom": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰に"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复对象"
          }
        }
      }
    },
    "Whose": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "持ち主"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所属"
          }
        }
      }
    },
    "Why it failed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "失敗した理由"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "失败原因"
          }
        }
      }
    },
    "With a unit, as in the file: 50MB, 25MiB, 10485760. A message over this is refused while it is still arriving, so the sender is told rather than left to wonder.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルと同じく単位を付けます：50MB、25MiB、10485760。これを超えるメールは受信の途中で拒否されるので、送信側は理由を知らされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要带单位，和配置文件里一样：50MB、25MiB、10485760。超过此值的邮件在接收过程中就会被拒绝，因此发件方会收到明确的告知，而不是不明所以。"
          }
        }
      }
    },
