          }
        }
      }
    },
    "%lld cards left out: their limits are not known.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 枚のカードを除外：限度額が不明です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 张卡未计入：额度未知。"
          }
        }
      }
    },
    "%lld checkouts here hold too few of your commits to be your work, so they are kept to their profile (what they are and where they live), and %lld files in them are left unread.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここの %1$lld 件のチェックアウトはあなたのコミットが少なすぎてあなたの仕事とは言えないため、何でありどこにあるかという概要だけを残し、その中の %2$lld 件のファイルは読んでいません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里有 %1$lld 个检出中属于你的提交太少，算不上你的工作，因此只保留它们的概要（是什么、在哪里），其中 %2$lld 个文件未被读取。"
          }
        }
      }
    },
    "%lld connections noticed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 件のつながりに気づきました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现 %lld 条新关联"
