{
  "sourceLanguage": "en",
  "strings": {
    "%@ in, %@ out · %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力 %1$@、出力 %2$@ · %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 %1$@，输出 %2$@ · %3$@"
          }
        }
      }
    },
    "%@ of %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%lld earlier messages": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ以前のメッセージ %lld 件"
          }
