            "state": "translated",
            "value": "達成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达成"
          }
        }
      }
    },
    "waiting for you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた待ち"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等你回应"
          }
        }
