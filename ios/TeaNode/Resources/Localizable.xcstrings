    "Library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图库"
          }
        }
