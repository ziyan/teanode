      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定リスト"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日程"
          }
        }
      }
    },
    "Alert from your mail": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールからのお知らせ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自邮件的提醒"
          }
        }
      }
    },
    "All day": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "終日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全天"
          }
        }
      }
    },
    "Allow TeaNode to use the camera in Settings, or paste the code's link instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で TeaNode にカメラの使用を許可するか、コードのリンクを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 TeaNode 使用相机，或改为粘贴二维码的链接。"
          }
        }
      }
    },
    "Already connected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经连接"
          }
        }
      }
    },
    "Answered": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已回答"
          }
        }
      }
    },
    "Answered elsewhere": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほかの場所で回答済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在别处回答"
          }
        }
      }
    },
    "Answers to what you asked from the phone": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンから尋ねたことへの答え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上提问的回答"
          }
        }
      }
    },
