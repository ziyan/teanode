        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你批准的事项"
          }
        }
      }
    },
    "Approve?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認しますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要批准吗？"
          }
        }
