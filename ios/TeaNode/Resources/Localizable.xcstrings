        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已经连接到 %@。"
          }
        }
      }
    },
    "This phone is connected to %@. To connect it to %@, sign out in Settings first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは %1$@ に接続されています。%2$@ に接続するには、先に「設定」でログアウトしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已连接到 %1$@。要连接到 %2$@，请先在“设置”中退出登录。"
          }
        }
      }
    },
    "This phone stops talking to your agent until you connect it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度接続するまで、このスマートフォンからエージェントと話せなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机将无法与助手交谈，直到你重新连接。"
          }
        }
      }
    },
    "This phone will be signed in as %@, and can do anything you can do on the dashboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは %@ としてサインインし、ダッシュボードでできることはすべてできるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机将以 %@ 的身份登录，可以做你在控制台上能做的任何事。"
          }
        }
      }
    },
    "This reminder repeats. Ticking it off moves it on to the next time.": {
      "localizations": {
