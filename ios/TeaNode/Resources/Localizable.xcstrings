    "Derived audio, transcripts and reference samples will be removed. Learned material will be reconciled.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "派生音频、转录和参考样本将被移除。学习所得资料将相应更新。"
          }
        },
        "ja": {
          "stringUnit": {
