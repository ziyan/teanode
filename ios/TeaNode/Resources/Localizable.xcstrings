    "Your agent knows the contact marked as you is you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたとして登録した連絡先が自分だとエージェントは理解します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手会知道标记为你的联系人就是你。"
          }
        }
