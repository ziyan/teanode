    "The name could not be saved. Try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を保存できませんでした。もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存名称，请重试。"
          }
        }
      }
    },
    "Live": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实况"
          }
        }
      }
    },
    "Photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        }
      }
    },
    "The file could not be read. Try again in a moment.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルを読み込めませんでした。しばらくしてからもう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该文件，请稍后重试。"
          }
        }
      }
    },
    "Faces are not found here": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここでは顔を検出しません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里不查找人脸"
          }
        }
      }
    },
    "Named “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」と名付けました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已命名为“%@”"
          }
        }
      }
    },
    "%@, with places": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@、撮影場所を含む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@，含拍摄地点"
          }
        }
      }
    },
    "Back up now": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐバックアップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "立即备份"
          }
        }
      }
    },
    "Turn off photo backup?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のバックアップをオフにしますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭照片备份？"
          }
        }
      }
    },
    "This file is not available. It may have been deleted, or it is no longer shared with you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このファイルは利用できません。削除されたか、共有が解除された可能性があります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件不可用。它可能已被删除，或已不再与你共享。"
          }
        }
      }
    },
    "Name this person": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物に名前を付ける"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为此人物命名"
          }
        }
      }
    },
    "No photos yet": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ写真がありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有照片"
          }
        }
      }
    },
    "Describing again…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明を作り直し中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重新生成描述…"
          }
        }
      }
    },
    "The Trash is empty": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱は空です"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "废纸篓是空的"
          }
        }
      }
    },
    "Favorite": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お気に入り"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收藏"
          }
        }
      }
    },
    "Photo backup is off, but its password could not be revoked. Revoke it under Devices, then Sync passwords.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のバックアップはオフになりましたが、パスワードを取り消せませんでした。「デバイス」の「同期パスワード」で取り消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片备份已关闭，但无法撤销其密码。请在“设备”的“同步密码”中撤销。"
          }
        }
      }
    },
    "Show in People": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人物」に表示する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在“人物”中显示"
          }
        }
      }
    },
    "Finds the people in your photos and groups them, so you can browse by person. Turning this off deletes the faces found so far and the names given to them. Your photos are not changed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に写っている人物を見つけてまとめ、人物ごとに見られるようにします。オフにすると、これまでに見つけた顔とその名前が削除されます。写真は変更されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找出照片中的人物并归类，方便按人物浏览。关闭后，已找到的人脸及其名称会被删除。你的照片不会改变。"
          }
        }
      }
    },
    "Trying again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "再試行しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在重试"
          }
        }
      }
    },
    "Your albums": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のアルバム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的相簿"
          }
        }
      }
    },
    "Shared by": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有元"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享者"
          }
        }
      }
    },
    "Largest file": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大ファイルサイズ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最大文件"
          }
        }
      }
    },
    "Remove name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前を削除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除名称"
          }
        }
      }
    },
    "Add photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を追加"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加照片"
          }
        }
      }
    },
    "No limit": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限なし"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无限制"
          }
        }
      }
    },
    "The details of this photo could not be read.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真の詳細を読み込めませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取这张照片的详细信息。"
          }
        }
      }
    },
    "Video": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ビデオ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "视频"
          }
        }
      }
    },
    "Also add photos of their own, and take out the ones they added.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分の写真を追加し、追加した写真を外すこともできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还可以添加自己的照片，并移出自己添加的照片。"
          }
        }
      }
    },
    "Text in the picture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真に写っている文字"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "图片中的文字"
          }
        }
      }
    },
    "Use as album cover": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムのカバーにする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为相簿封面"
          }
        }
      }
    },
    "Describe a photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の説明の作成"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述照片"
          }
        }
      }
    },
    "Photo backup is already on for %@. Turn it off for that account first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ では写真のバックアップがすでにオンです。先にそのアカウントでオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %@ 开启照片备份。请先为该账户关闭。"
          }
        }
      }
    },
    "Added to “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に追加しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已添加到“%@”"
          }
        }
      }
    },
    "Albums shared with you": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたと共有されているアルバム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与你共享的相簿"
          }
        }
      }
    },
    "Use the three-letter code, such as usd.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "usd のように3文字のコードで入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用三个字母的代码，例如 usd。"
          }
        }
      }
    },
    "Costs nothing itself. It only works on something an earlier call through this share made, such as checking or cancelling it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それ自体に費用はかかりません。この共有の以前の呼び出しが作ったものにだけ使えます（確認や取り消しなど）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本身不花钱。只能用于此共享中先前调用所产生的内容，例如查询或取消它。"
          }
        }
      }
    },
    "Only %@ can ask %@, %@'s agent, in this chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットで%3$@のエージェントの%2$@に頼めるのは%1$@だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个聊天里，只有 %1$@ 可以呼叫 %3$@ 的助手 %2$@。"
          }
        }
      }
    },
    "Spends money. Calls within your limits go ahead; bigger ones wait for you.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お金を使います。上限内の呼び出しはそのまま実行され、それを超えるものは承認を待ちます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会花钱。在上限内的调用直接执行，超过的会等你确认。"
          }
        }
      }
    },
    "Your agent remembers this chat": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのエージェントがこのチャットを記憶中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手记住了这个聊天"
          }
        }
      }
    },
    "The limit for one payment cannot be above the monthly limit.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回の支払いの上限は、1か月の上限を超えられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单笔付款的上限不能高于每月上限。"
          }
        }
      }
    },
    "Refused": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拒否"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "被拦截"
          }
        }
      }
    },
    "Only %@ can ask %@'s agent in this chat.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチャットで%2$@のエージェントに頼めるのは%1$@だけです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个聊天里，只有 %1$@ 可以呼叫 %2$@ 的助手。"
          }
        }
      }
    },
    "There may be more; use more words": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他にもある可能性があります。言葉を増やして絞り込んでください"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能还有更多；请多加几个词来缩小范围"
          }
        }
      }
    },
    "%@ is in %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を%2$@に追加しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已加入%2$@"
          }
        }
      }
    },
    "No limits: every call waits for approval, except one that only works on something an earlier call through this share made": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限なし：この共有の以前の呼び出しが作ったものにだけ使える呼び出しを除き、すべての呼び出しは承認を待ちます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有上限：除了只作用于此共享中先前调用所产生内容的调用，每次调用都要等待批准"
          }
        }
      }
    },
    "%@ saved in %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ を%2$@に保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 已保存到%2$@"
          }
        }
      }
    },
    "Message, or @ to ask an agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージ、または @ でエージェントに頼む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发消息，或输入 @ 呼叫助手"
          }
        }
      }
    },
    "Your agent is off.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのエージェントはオフです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的助手未开启。"
          }
        }
      }
    },
    "Others may ask your agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人もあなたのエージェントに頼めます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人可以呼叫你的助手"
          }
        }
      }
    },
    "Everyone in %@ (%@)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の全員（%@）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的所有人（%@）"
          }
        }
      }
    },
    "Per month": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1か月あたり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每月"
          }
        }
      }
    },
    "Skill calls waiting for your approval": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの承認待ちのスキル呼び出し"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待你批准的技能调用"
          }
        }
      }
    },
    "Per payment": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回あたり"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每笔"
          }
        }
      }
    },
    "It was refused before it ran.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行前に拒否されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行前就被拦截。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
