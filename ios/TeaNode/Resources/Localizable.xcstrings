            "state": "translated",
            "value": "ナレッジ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "知识"
          }
        }
      }
    },
    "Language": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言"
          }
        }
      }
    },
    "Language code": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "言語コード"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语言代码"
          }
        }
      }
    },
    "Last graded %@ · questions: %lld · cost %@": {
      "localizations": {
        "ja": {
