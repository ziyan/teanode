        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，%2$@ 写道："
          }
        }
      }
    },
    "On a computer, open your dashboard. In Settings, open Phones and choose Connect a phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パソコンでダッシュボードを開き、「設定」の「スマートフォン」で「スマートフォンを接続」を選びます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在电脑上打开控制台，在“设置”中打开“手机”，选择“连接手机”。"
          }
        }
      }
    },
    "On days (1 Monday to 7 Sunday)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曜日（1 月曜〜7 日曜）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
