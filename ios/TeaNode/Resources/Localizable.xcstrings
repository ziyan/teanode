    "You": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你"
          }
        }
      }
    },
    "You get a new import address, and mail to the old one is refused from now on. What was already imported stays.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "新しい取り込みアドレスになり、古いアドレスへのメールは今後受け付けません。取り込み済みのものはそのまま残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会得到新的导入地址，从现在起发往旧地址的邮件都会被拒收。已导入的内容会保留。"
          }
        }
      }
    },
    "You have no mailbox address to receive statements at.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明細を受け取れるメールボックスのアドレスがありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有可接收对账单的邮箱地址。"
          }
        }
      }
    },
    "You have no mailbox address to receive them; add the files instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受け取れるメールボックスのアドレスがありません。ファイルを追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你没有可接收邮件的邮箱地址；请改为添加文件。"
          }
        }
      }
    },
    "You have no mailboxes yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールボックスがまだありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有邮箱。"
          }
        }
      }
    },
    "You have not left any lists": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "解除したリストはありません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有退订任何列表"
          }
        }
      }
    },
    "You may see the groups on this server but not the accounts in them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーのグループは見られますが、その中のアカウントは見られません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以查看此服务器上的组，但不能查看其中的账号。"
          }
        }
      }
    },
    "You reacted %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でリアクションしました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你回应了 %@"
          }
        }
      }
    },
    "You will sign in as %@ instead of %@ from now on. Your sessions and API tokens move with the account.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以後は %2$@ ではなく %1$@ でサインインします。セッションと API トークンはアカウントとともに移ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今后你将以 %1$@ 而不是 %2$@ 登录。会话和 API 令牌会随账号一起迁移。"
          }
        }
      }
    },
    "Your %@ bot": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 %@"
          }
        }
      }
    },
    "Your agent is not following anything right now.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントは今、何も追いかけていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "代理现在没有在跟进任何事。"
          }
        }
      }
    },
    "Your agent will tell you when %@ finishes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ が終わったらエージェントが知らせます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 完成时你的助手会告诉你"
          }
        }
      }
    },
    "Your Plaid developer account. Plaid is offered to people only once the client ID and the secret are both set.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaid 開発者アカウント。クライアント ID とシークレットの両方を設定するまで、Plaid は利用者に提示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Plaid 开发者账户。只有同时设置了客户端 ID 和密钥，才会向用户提供 Plaid。"
          }
        }
      }
    },
    "Your account": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのアカウント"
          }
        },
        "zh-Hans": {
