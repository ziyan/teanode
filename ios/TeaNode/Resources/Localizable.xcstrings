    "Ask %@…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ に尋ねる…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "问问 %@ …"
          }
        }
      }
    },
    "Ask about your mail, or ask for something to be done.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールについて尋ねたり、何かを頼んだりできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以问问你的邮件，或让助手去做点什么。"
          }
        }
      }
    },
    "Ask your agent anything: your mail, your calendar, a picture of a receipt.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メール、カレンダー、レシートの写真など、何でもエージェントに尋ねられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以问助手任何事：你的邮件、日历，或一张收据的照片。"
          }
        }
      }
    },
    "Ask your agent…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに尋ねる…"
          }
        },
        "zh-Hans": {
