            "value": "在 Telegram 中打开 @BotFather，发送 /newbot，然后粘贴它给出的令牌。"
          }
        }
      }
    },
    "In a directory (optional)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディレクトリ内（任意）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在某个目录中（可选）"
          }
        }
      }
    },
    "In layout %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レイアウト %@ 内"
          }
        },
        "zh-Hans": {
