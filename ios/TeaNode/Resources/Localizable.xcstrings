          "stringUnit": {
            "state": "translated",
            "value": "按下述策略替我回复邮件"
          }
        }
      }
    },
    "Answer on record": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された答え"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录的答案"
          }
        }
      }
    },
    "Answer sent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を送信しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复已发送"
          }
        }
