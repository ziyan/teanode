        }
      }
    },
    "Type this into the machine now. It is shown this once and cannot be shown again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今すぐ機器に入力してください。この一度だけ表示され、二度と表示できません。"
