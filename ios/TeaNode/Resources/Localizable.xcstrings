          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待处理"
          }
        }
      }
    },
    "People": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザー"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人员"
          }
        }
      }
    },
    "People I have written to before": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前やり取りした人"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我写过信的人"
          }
        }
      }
    },
    "People and access": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーとアクセス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "人员与权限"
          }
        }
      }
    },
    "People may attach their own browser tab through the extension": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用者が拡張機能で自分のタブを接続できる"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用户可通过扩展附加自己的浏览器标签页"
          }
        }
      }
    },
    "People sign in through an OpenID Connect provider, such as Entra ID, Okta, Google, Keycloak or Authentik, with a button on the sign-in page for each one listed here. Their groups at the provider put them in the groups here that name them.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenID Connect プロバイダー（Entra ID、Okta、Google、Keycloak、Authentik など）でサインインします。ここに登録したプロバイダーごとにサインインページにボタンが表示されます。プロバイダー側のグループに応じて、それを名前に持つこちらのグループに所属します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过 OpenID Connect 提供方（Entra ID、Okta、Google、Keycloak、Authentik 等）登录，这里列出的每个提供方都会在登录页显示一个按钮。用户在提供方的群组会让他们加入这里以其命名的群组。"
          }
        }
      }
    },
    "Per kind of work": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業の種類ごと"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按工作类型"
          }
        }
      }
    },
    "Per million tokens, as the prices above are. The first line whose model matches is the one used, so a pattern ending in * can sit under the exact names it should not cover. Anything not matched costs what the provider costs.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の価格と同じく 100 万トークンあたりです。モデルが一致する最初の行が使われるので、* で終わるパターンは、対象にしない正確な名前の下に置けます。一致しないものはプロバイダーの価格になります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与上面的价格一样按每百万 token 计。使用第一条匹配模型的价格，所以以 * 结尾的模式可以放在它不应覆盖的确切名称下面。未匹配的按提供方的价格计算。"
          }
        }
      }
    },
    "Permissions over every domain, present and future": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在と将来のすべてのドメインに対する権限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作用于现在和将来所有域名的权限"
          }
        }
      }
    },
    "Personal agents": {
