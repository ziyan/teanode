      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "住所"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
