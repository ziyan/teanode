          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地点"
          }
        }
      }
    },
    "Photo backup is off. Revoke its password under Devices, then Sync passwords.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のバックアップはオフになりました。「デバイス」の「同期パスワード」でそのパスワードを取り消してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片备份已关闭。请在“设备”的“同步密码”中撤销其密码。"
          }
        }
      }
    },
    "Finding faces is off": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "顔の検出がオフです"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "查找人脸已关闭"
          }
        }
      }
    },
    "Level": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "権限"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "权限"
          }
        }
      }
    },
    "Their photos are gone from your library, or were moved to the Trash.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この人物の写真はライブラリにないか、ゴミ箱に移動されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "他们的照片已不在你的资料库中，或已移到废纸篓。"
          }
        }
      }
    },
    "Share with a circle": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルと共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与圈子共享"
          }
        }
      }
    },
    "TeaNode can only see some of your photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode には写真の一部しか見えません。"
