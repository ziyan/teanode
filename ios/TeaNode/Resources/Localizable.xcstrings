    "Allow TeaNode to read your contacts in Settings to bring them into your address book.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先をアドレス帳に読み込むには、設定で TeaNode に連絡先の読み取りを許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 TeaNode 读取你的通讯录，以便导入到你的地址簿。"
          }
        }
      }
    },
    "Allow TeaNode to use the camera in Settings, or paste the code's link instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で TeaNode にカメラの使用を許可するか、コードのリンクを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 TeaNode 使用相机，或改为粘贴二维码的链接。"
          }
        }
      }
    },
    "Allow list (addresses or domains)": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可リスト（アドレスまたはドメイン）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许列表（地址或域名）"
          }
        }
      }
    },
    "Allow signing in with a passkey": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスキーでのサインインを許可する"
          }
