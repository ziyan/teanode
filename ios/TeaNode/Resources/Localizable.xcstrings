    },
    "%@ of %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "%@ of %@ by %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ までに %1$@ / %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ 前 %1$@ / %2$@"
          }
        }
      }
    },
    "%@ of %@ documents read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 件中 %1$@ 件を読了"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已读 %1$@ / %2$@ 份文档"
          }
        }
      }
    },
    "%@ of %@ mailboxes": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ メールボックス"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ / %@ 个邮箱"
          }
        }
      }
    },
    "%@ of %@ messages learned, silent until then": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@/%@ 通を学習済み、達するまで沈黙"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已学习 %@/%@ 封，达到前保持沉默"
          }
        }
      }
    },
    "%@ of %@ set": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%2$@ 件中 %1$@ 件設定済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已设置 %2$@ 项中的 %1$@ 项"
          }
        }
      }
    },
    "%@ of %@ today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "本日 %@ / %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今日 %@ / %@"
          }
        }
      }
    },
    "%@ owed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未払い %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欠款 %@"
          }
        }
      }
    },
    "%@ plan": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ プラン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 套餐"
          }
        }
      }
