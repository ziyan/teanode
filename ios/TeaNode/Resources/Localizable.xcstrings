      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "画面で承認が必要です：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要你在屏幕上批准：%@"
          }
        }
      }
    },
