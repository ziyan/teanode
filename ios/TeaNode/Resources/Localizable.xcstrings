    "Shared with %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@と共有しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已共享给%@"
          }
        }
      }
    },
    "Describing photos is not available.": {
      "localizations": {
