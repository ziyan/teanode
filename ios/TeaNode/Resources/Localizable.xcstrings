            "state": "translated",
            "value": "删除圈子"
          }
        }
      }
    },
    "The circle is removed for everyone in it. No account is deleted.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルは全員から削除されます。アカウントは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
