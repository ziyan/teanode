            "value": "この写真を説明"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述这张照片"
          }
        }
      }
    },
    "All kinds": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべての種類"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有类型"
          }
        }
      }
    },
    "Photo backup is off and its password is revoked.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真のバックアップをオフにし、そのパスワードを取り消しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片备份已关闭，其密码已撤销。"
          }
        }
      }
    },
    "Photos you mark with a heart are kept here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハートを付けた写真はここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记了心形的照片会显示在这里。"
          }
        }
      }
    },
    "A file over the largest size is not backed up, and nothing more is taken once the space is used.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最大サイズを超えるファイルはバックアップされず、容量を使い切るとそれ以上は受け付けられません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过最大大小的文件不会被备份，空间用完后也不会再接收新内容。"
          }
        }
      }
    },
    "The server would not take this file.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーはこのファイルを受け付けませんでした。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器不接受此文件。"
          }
        }
      }
    },
    "Save to my library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "自分のライブラリに保存"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到我的图库"
          }
        }
      }
    },
    "Getting this photo ready": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真を準備しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在处理这张照片"
          }
        }
      }
    },
    "Shown in People again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人物」に再び表示しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已重新在“人物”中显示"
          }
        }
      }
    },
    "Describe again": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "説明を作り直す"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新生成描述"
          }
        }
      }
    },
    "This album is not shared with anybody yet.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアルバムはまだ誰とも共有されていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个相簿还没有与任何人共享。"
          }
        }
      }
    },
    "On for %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ でオン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已为 %@ 开启"
          }
        }
      }
    },
    "Back up this iPhone": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone をバックアップ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份这部 iPhone"
          }
        }
      }
    },
    "Already in “%@”": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すでに「%@」に入っています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已在“%@”中"
          }
        }
      }
    },
    "Restored to your library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリに戻しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已恢复到图库"
          }
        }
      }
    },
    "Open in Photos": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真で開く"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在照片中打开"
          }
        }
      }
    },
    "Move this photo to the Trash?": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この写真をゴミ箱に入れますか？"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要将这张照片移到废纸篓吗？"
          }
        }
      }
    },
    "Live Photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Live Photos"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实况照片"
          }
        }
      }
    },
    "Photos and videos go up over Wi-Fi unless you allow mobile data. The Hidden album is left out unless you include it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モバイルデータ通信を許可しない限り、写真とビデオは Wi-Fi でのみアップロードされます。「非表示」アルバムは、含める設定にしない限りバックアップされません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你允许使用移动数据，否则照片和视频只通过 Wi-Fi 上传。“已隐藏”相簿默认不备份，除非你选择包含。"
          }
        }
      }
    },
    "The first day is after the last day, so no photo matches.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最初の日が最後の日より後なので、一致する写真はありません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一天晚于最后一天，因此没有照片符合。"
          }
        }
      }
    },
    "Your library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたのライブラリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的照片库"
          }
        }
      }
    },
    "This server cannot find faces in photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーでは写真から顔を検出できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此服务器无法查找照片中的人脸。"
          }
        }
      }
    },
    "Album cover changed": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバムのカバーを変更しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿封面已更改"
          }
        }
      }
    },
    "Include where photos were taken": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真の撮影場所を含める"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包含照片的拍摄地点"
          }
        }
      }
    },
    "Cannot play this video": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビデオを再生できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法播放此视频"
          }
        }
      }
    },
    "TeaNode is not allowed to add to your Photos. Allow it in Settings, under Photos.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode は写真への追加を許可されていません。設定の「写真」で許可してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode 无权向“照片”添加内容。请在“设置”的“照片”中允许。"
          }
        }
      }
    },
    "Date and time": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付と時刻"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日期和时间"
          }
        }
      }
    },
    "The photos stay in your library.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真はライブラリに残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片仍会保留在你的图库中。"
          }
        }
      }
    },
    "Naming people means choosing a contact from your address book, and Contacts is not turned on for you. Ask whoever runs this server to turn on Contacts.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "人物に名前を付けるには連絡先から選ぶ必要がありますが、連絡先が有効になっていません。このサーバーの管理者に連絡先を有効にしてもらってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为人物命名需要从通讯录中选择联系人，而你的账户没有开启联系人功能。请让管理此服务器的人开启联系人。"
          }
        }
      }
    },
    "Photos and videos on this iPhone are copied to your TeaNode server. Deleting a photo on this iPhone does not delete it from TeaNode.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この iPhone の写真とビデオは TeaNode サーバーにコピーされます。この iPhone で写真を削除しても、TeaNode からは削除されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部 iPhone 上的照片和视频会复制到你的 TeaNode 服务器。在这部 iPhone 上删除照片不会把它从 TeaNode 中删除。"
          }
        }
      }
    },
    "Photo": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "照片"
          }
        }
      }
    },
    "Choose photos in your library and add them here.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリで写真を選んで、ここに追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在图库中选择照片，再添加到这里。"
          }
        }
      }
    },
    "You do not share a circle with anybody yet. Make or join a circle to share an album.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰ともサークルを共有していません。サークルを作成するか参加すると、アルバムを共有できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有与任何人共享圈子。创建或加入一个圈子，即可共享相簿。"
          }
        }
      }
    },
    "Save original": {
