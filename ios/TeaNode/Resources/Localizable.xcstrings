            "state": "translated",
            "value": "进度正常"
          }
        }
      }
    },
    "One address per line": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1行に1アドレス"
          }
        },
        "zh-Hans": {
