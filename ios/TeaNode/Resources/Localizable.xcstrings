    "The people you share this server with, grouped as family, friends or colleagues.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーを共有する人たちを、家族、友人、同僚に分けて表示します。"
          }
