    "Stopped": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止"
          }
        }
      }
    },
    "Stopped after the most rounds a turn may take.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1ターンで可能な最大ラウンド数に達したため停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达到一轮允许的最多回合，已停止。"
          }
        }
      }
    },
    "Stopped.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止。"
          }
        }
      }
    },
    "Stopped: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止しました：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：%@"
          }
        }
      }
    },
    "Stopped: the same call failed three times.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "停止しました：同じ呼び出しが3回失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已停止：同一个调用连续失败了三次。"
          }
        }
      }
    },
    "Talk to your agent from your phone.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スマートフォンからエージェントと話せます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在手机上和你的助手交谈。"
          }
        }
      }
    },
    "TeaNode": {
      "shouldTranslate": false
    },
    "That card was already answered, or is no longer waiting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードはすでに回答済みか、もう待っていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张卡片已被回答，或已不再等待。"
          }
        }
      }
    },
    "That did not reach your agent: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントに届きませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没能送到助手：%@"
          }
        }
      }
    },
    "That is not a TeaNode connect code. Use the code on your dashboard's Connect a phone page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode の接続コードではありません。ダッシュボードの「スマートフォンを接続」ページのコードを使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这不是 TeaNode 连接码。请使用控制台“连接手机”页面上的二维码。"
          }
        }
      }
    },
    "That link has no code in it. Make a new one on your dashboard's Connect a phone page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリンクにはコードが含まれていません。ダッシュボードの「スマートフォンを接続」ページで新しいコードを作成してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个链接里没有连接码。请在控制台的“连接手机”页面生成一个新的。"
          }
        }
      }
    },
    "The agent's steps": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェントの手順"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手的步骤"
          }
        }
      }
    },
    "The call lost its connection.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通話の接続が切れました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通话连接已断开。"
          }
        }
      }
    },
    "The camera is not available": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラを使用できません"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用相机"
          }
        }
      }
    },
    "The earlier chat was folded into a note.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "それまでのチャットはメモにまとめられました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前的聊天已折叠成一份笔记。"
          }
        }
      }
    },
    "The files come to more than 25 MB, more than the server takes in one message.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルの合計が 25 MB を超えており、サーバーが 1 通で受け取れる量を超えています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件超过 25 MB，超出服务器一条消息能接收的大小。"
          }
        }
      }
    },
    "The microphone could not be started: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクを起動できませんでした：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法启动麦克风：%@"
          }
        }
      }
    },
    "The microphone's format cannot be sent.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクの音声形式を送信できません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法发送麦克风的音频格式。"
          }
        }
      }
    },
    "The server could not be reached. Check the connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーに接続できませんでした。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接服务器。请检查网络后重试。"
          }
        }
      }
    },
    "The turn failed.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンは失敗しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一轮失败了。"
          }
        }
      }
    },
    "The turn failed: %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このターンは失敗しました：%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一轮失败了：%@"
          }
        }
      }
    },
    "Thinking…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "考え中…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "思考中…"
          }
        }
      }
    },
    "This is %@'s agent. What you say here reaches it as %@, and the server log says you did.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは %@ のエージェントです。ここで話しかけると %@ として届き、サーバーのログにそのことが残ります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 %@ 的助手。你在这里说的话会以 %@ 的身份到达它，服务器日志会记录这一点。"
          }
        }
      }
    },
    "This phone is already connected to %@.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンはすでに %@ に接続されています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已经连接到 %@。"
          }
        }
      }
    },
    "This phone is connected to %@. To connect it to %@, sign out in Settings first.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは %1$@ に接続されています。%2$@ に接続するには、先に「設定」でログアウトしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机已连接到 %1$@。要连接到 %2$@，请先在“设置”中退出登录。"
          }
        }
      }
    },
    "This phone stops talking to your agent until you connect it again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう一度接続するまで、このスマートフォンからエージェントと話せなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机将无法与助手交谈，直到你重新连接。"
          }
        }
      }
    },
    "This phone will be signed in as %@, and can do anything you can do on the dashboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンは %@ としてサインインし、ダッシュボードでできることはすべてできるようになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这部手机将以 %@ 的身份登录，可以做你在控制台上能做的任何事。"
          }
        }
      }
    },
    "Title": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タイトル"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题"
          }
        }
      }
    },
    "To manage what this phone is told about, open Phones under Agent on your dashboard.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このスマートフォンに届く通知は、ダッシュボードの「エージェント」の「スマートフォン」で管理できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要管理这部手机接收哪些通知，请在控制台的“助手”下打开“手机”。"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "Unarchive": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アーカイブを解除"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消归档"
          }
        }
      }
    },
    "Unmute": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
