            "value": "編集済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已编辑"
          }
        }
      }
    },
    "Links to other shared pages": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有されている他のページへのリンク"
          }
        },
        "zh-Hans": {
