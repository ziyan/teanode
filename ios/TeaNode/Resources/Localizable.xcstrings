            "state": "translated",
            "value": "会議名（任意）"
          }
        }
      }
    },
    "Everyone should know you are recording. TeaNode stays silent and saves the audio locally.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请让所有参与者知道您在录音。TeaNode 不会发声，并在本地保存音频。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "参加者全員に録音することを伝えてください。TeaNode は発声せず、音声を端末に保存します。"
          }
        }
      }
    },
