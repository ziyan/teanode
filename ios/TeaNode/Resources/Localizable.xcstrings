          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上次完成"
          }
        }
      }
    },
    "Reading your photo library": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真ライブラリを読み込んでいます"
