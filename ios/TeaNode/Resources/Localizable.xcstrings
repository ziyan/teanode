          }
        }
      }
    },
    "You do not share a circle with anybody yet. Start or join one under Circles to share a skill.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだ誰ともサークルを共有していません。スキルを共有するには、サークルを作るか参加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有和任何人共享圈子。要共享技能，请先在“圈子”中创建或加入一个圈子。"
          }
        }
      }
    },
    "Agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "エージェント"
          }
        },
        "zh-Hans": {
