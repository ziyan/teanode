{
  "sourceLanguage": "en",
  "strings": {
    "\"Confirm appointments and answer simple questions about opening hours; anything about money, wait for me.\"": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「予約の確認と営業時間についての簡単な質問には答える。お金に関することは私を待つ。」"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"确认预约并回答关于营业时间的简单问题；涉及金钱的一律等我。\""
          }
        }
      }
    },
    "#%lld %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@"
          }
        }
      }
    },
    "#%lld %@ · folded into #%lld": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@ · #%3$lld に統合"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "#%1$lld %2$@ · 已并入 #%3$lld"
          }
        }
      }
    },
    "%@ %@ @ %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ @ %3$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@ @ %3$@"
          }
        }
      }
    },
    "%@ %@ since %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%3$@ から %1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@，自 %3$@ 起"
          }
