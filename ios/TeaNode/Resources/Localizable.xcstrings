    "Link a bank from your dashboard: Settings, then Agent, then Finance.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダッシュボードで銀行を連携してください：設定 › エージェント › 家計。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在控制台关联银行：设置 › 助手 › 财务。"
          }
        }
      }
    },
    "Link a contact": {
      "localizations": {
