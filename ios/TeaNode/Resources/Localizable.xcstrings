          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行中"
          }
        }
      }
    },
    "“%@” and everything in it, the files that came with it too.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とその中身すべて、添付されたファイルも削除されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其中的全部内容，包括随附的文件。"
