          }
        }
      }
    },
    "Open the menu to read and write to the people you share a circle with.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューを開くと、サークルを共有している人とやり取りできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开菜单，即可与和你同在一个圈子的人聊天。"
          }
        }
      }
    },
    "How much": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見せる範囲"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享范围"
          }
        }
      }
    },
    "Others may ask their agent": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他の人もこの人のエージェントに頼めます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他人可以呼叫其助手"
          }
        }
      }
    },
    "The account %@ was made, but it could not be put in the circle (%@). Try again to add it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント%1$@は作成しましたが、サークルに追加できませんでした（%2$@）。もう一度追加してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账号 %1$@ 已创建，但无法加入圈子（%2$@）。请重试添加。"
          }
        }
      }
    },
    "Share…": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共有…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享…"
          }
        }
      }
    },
    "Nothing was declined. Check your connection and try again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も断っていません。接続を確認して、もう一度お試しください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有拒绝任何内容。请检查网络连接后再试一次。"
          }
        }
      }
    },
    "Share a skill": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキルを共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共享技能"
          }
        }
      }
    },
    "Waits until %@, then expires.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@まで待ち、その後は期限切れになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待到 %@，之后过期。"
          }
        }
      }
    },
    "Several agents are thinking": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複数のエージェントが考え中"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多个助手正在思考"
          }
        }
      }
    },
    "Make admin": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理者にする"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为管理员"
          }
        }
      }
    },
    "Approved. It ran on the owner’s computer.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認され、持ち主のコンピューターで実行されました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已批准，并在对方的电脑上运行。"
          }
        }
      }
    },
    "This shares at least %lld pages: this one and everything under it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページとその下のすべて、%lldページ以上を共有します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将共享至少 %lld 个页面：这个页面以及它下面的所有页面。"
          }
        }
      }
    },
    "They see when you are busy, and nothing else.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "予定があるかどうかだけが見え、内容は見えません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对方只能看到你什么时候忙，看不到其他内容。"
          }
        }
      }
    },
    "That picture could not be read. Use a JPEG or PNG.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その写真を読み込めませんでした。JPEG か PNG を使ってください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取该图片。请使用 JPEG 或 PNG。"
          }
        }
      }
    },
    "Read by %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が既読"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已读"
          }
        }
      }
    },
    "Enter the username of an account on this server.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーにあるアカウントのユーザー名を入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入这台服务器上某个账号的用户名。"
          }
        }
      }
    },
    "This page is not shared with you, or the person stopped sharing it.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このページはあなたに共有されていないか、相手が共有をやめました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个页面没有共享给你，或者对方已停止共享。"
          }
        }
      }
    },
    "Picture saved": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を保存しました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像已保存"
          }
        }
      }
    },
    "Leave circle": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サークルから退出"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退出圈子"
          }
        }
      }
    },
    "Choose a picture": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "写真を選ぶ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择头像"
          }
        }
      }
    },
    "Also show the words each fact was read in": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各事実の出典となった文面も表示する"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同时显示每条事实出处的原文"
          }
        }
      }
    },
    "Above these limits, or when the amount cannot be read, the call waits for you. The limits are in the currency you give. A call that fails still counts toward the month, in case the money moved.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限を超える場合や金額が読み取れない場合、呼び出しはあなたの承認を待ちます。上限は入力した通貨で数えます。失敗した呼び出しも、お金が動いた可能性があるため、その月の合計に数えます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "超过上限，或无法读出金额时，这次调用会等待你的确认。上限以你填写的币种计算。失败的调用也计入当月，因为钱可能已经付出。"
          }
        }
      }
    },
    "Shared as part of %@": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の一部として共有"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "作为%@的一部分共享"
          }
        }
      }
    },
    "Group name": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ名"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "群名称"
          }
        }
      }
    },
    "%@ will no longer read this page.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は、このページを読めなくなります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@将不再能读取这个页面。"
          }
        }
      }
    },
    "Details, and can edit": {
