            "state": "translated",
            "value": "此商家总是如此"
          }
        }
      }
    },
    "Always in its prompt": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "常にプロンプトに含む"
          }
        },
        "zh-Hans": {
          "stringUnit": {
