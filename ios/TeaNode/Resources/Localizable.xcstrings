    "Albums": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルバム"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相簿"
          }
        }
      }
    },
    "Without it, they see each picture without its place, and cannot get the original files.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフの場合、写真は撮影場所なしで表示され、オリジナルのファイルは受け取れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不包含时，他们看到的图片不带拍摄地点，也无法获取原始文件。"
          }
        }
      }
    },
    "Everything is backed up": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてバックアップ済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部已备份"
          }
