      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会話の言語"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话语言"
          }
        }
      }
    },
    "Tap the photo to see it full size.": {
      "localizations": {
