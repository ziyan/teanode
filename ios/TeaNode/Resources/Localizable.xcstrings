    "TeaNode": {
      "shouldTranslate": false
    },
    "TeaNode may not use the microphone. Allow it in Settings, then call again.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode はマイクを使えません。設定で許可してから、もう一度かけてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TeaNode 无法使用麦克风。请在“设置”中允许后再拨打。"
          }
        }
      }
    },
    "That card was already answered, or is no longer waiting.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このカードはすでに回答済みか、もう待っていません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这张卡片已被回答，或已不再等待。"
          }
        }
      }
    },
    "That contact could not be read": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この連絡先を読み込めませんでした"
