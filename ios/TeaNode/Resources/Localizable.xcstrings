    "Allow TeaNode to use the camera in Settings, or paste the code's link instead.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「設定」で TeaNode にカメラの使用を許可するか、コードのリンクを貼り付けてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中允许 TeaNode 使用相机，或改为粘贴二维码的链接。"
          }
        }
      }
    },
    "Already connected": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続済み"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已经连接"
          }
