{
  "description": "Shared cases for reading an otpauth address. internal/passwords (onetimecode_test.go) and the dashboard and extension (web/src/passwords/oneTimeCode.ts, oneTimeCode.test.ts) both read this file and must give the same answers; the iPhone reads it as well. The reading is strict: the host is exactly totp (no user name, no port), the query has no malformed percent escape and no semicolon, a control character anywhere is refused, only ASCII white space is trimmed from the ends, the secret is base32 letters with spaces and hyphens ignored and \"=\" only at the end, and the digit count and the period are plain ASCII digits with a period of at most 2147483647. Every secret is the invented text Hello! followed by the bytes deadbeef (JBSWY3DPEHPK3PXP) or a short variant of it; every name is invented. expectedCodes are the codes at each of unixSeconds.",
  "unixSeconds": [
    0,
    59,
    1111111109,
    1234567890,
    2000000000,
    4102444800
  ],
  "cases": [
    {
      "name": "a label with an issuer and an account",
      "address": "otpauth://totp/Example:ada@example.test?secret=JBSWY3DPEHPK3PXP&issuer=Example",
      "isValid": true,
      "secretHex": "48656c6c6f21deadbeef",
      "algorithm": "SHA1",
      "digitCount": 6,
      "periodSeconds": 30,
      "issuer": "Example",
      "accountName": "ada@example.test",
      "expectedCodes": [
        "282760",
        "996554",
        "071271",
        "742275",
        "890699",
        "573258"
      ]
