/build
/data
/experiments
/coverage.out
/coverage.html

# Generated code
*_gen.go

# Frontend
/web/node_modules/
/web/dist/

# Frontend build output embedded into the binary
/internal/frontend/static/*
!/internal/frontend/static/.gitkeep

# Local tooling state. Nothing here is the project's; it belongs to whoever
# is working on it. Named explicitly because the first commit of a fresh
# repository is made with "git add -A", and this directory has to be excluded
# by a rule in the repository rather than by anything on one machine.
/.claude/

# Development state: config, keys, spool and the containers' volumes.
/dev/

# Generated by "make test-deployment": a configuration with keys in it, and
# the state of a throwaway stack.
/deploy/test/
